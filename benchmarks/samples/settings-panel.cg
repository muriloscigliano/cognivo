root = Stack([title, tabs], "column", "lg")
title = TextContent("Settings", "2xl", "bold")
tabs = Tabs(tabItems)
tabItems = [{value: "profile", label: "Profile"}, {value: "security", label: "Security"}, {value: "notifications", label: "Notifications"}]
profileForm = Form([avatarSection, nameField, emailField, bioField, saveBtn], "profile", "md")
avatarSection = Stack([avatarImg, avatarBtns], "row", "md", "center")
avatarImg = Image("https://picsum.photos/96/96", "Profile photo", "1:1")
avatarBtns = Stack([uploadBtn, removeBtn], "column", "xs")
uploadBtn = Button("Upload Photo", "secondary", "sm")
removeBtn = Button("Remove", "tertiary", "sm", "danger")
nameField = Stack([nameLabel, nameRow], "column", "xs")
nameLabel = Label("Full Name")
nameRow = Stack([firstInput, lastInput], "row", "sm")
firstInput = Input("First name", "firstName")
lastInput = Input("Last name", "lastName")
emailField = Stack([emailLabel, emailInput], "column", "xs")
emailLabel = Label("Email", "This is your primary email for notifications.", "", true)
emailInput = Input("user@example.com", "email", "email")
bioField = Stack([bioLabel, bioInput], "column", "xs")
bioLabel = Label("Bio", "Brief description for your profile.")
bioInput = Textarea("Tell us about yourself...", "bio", 4, 200, true)
saveBtn = Button("Save Changes", "primary")
securityForm = Form([passwordSection, twoFactorSection], "security", "lg")
passwordSection = Section("Change Password", "Update your password regularly for security.", true, true)
passwordContent = Stack([currentPw, newPw, confirmPw], "column", "sm")
currentPw = Stack([Label("Current Password"), Input("", "currentPassword", "password")], "column", "xs")
newPw = Stack([Label("New Password", "Must be at least 8 characters."), Input("", "newPassword", "password")], "column", "xs")
confirmPw = Stack([Label("Confirm Password"), Input("", "confirmPassword", "password")], "column", "xs")
twoFactorSection = Stack([twoFactorRow, twoFactorNote], "column", "sm")
twoFactorRow = Stack([twoFactorLabel, twoFactorToggle], "row", "md", "center", "between")
twoFactorLabel = TextContent("Two-Factor Authentication", "md", "semibold")
twoFactorToggle = Switch("Enable 2FA", "Adds an extra layer of security to your account.")
twoFactorNote = Callout("info", "Recommended", "Two-factor authentication significantly reduces the risk of unauthorized access.")
notifForm = Form([emailNotifs, pushNotifs], "notifications", "lg")
emailNotifs = Stack([emailNotifsTitle, marketingSwitch, updatesSwitch, securitySwitch], "column", "md")
emailNotifsTitle = TextContent("Email Notifications", "lg", "semibold")
marketingSwitch = Switch("Marketing emails", "Receive product updates and promotions.")
updatesSwitch = Switch("Product updates", "Get notified about new features and improvements.")
securitySwitch = Switch("Security alerts", "Important alerts about your account security.")