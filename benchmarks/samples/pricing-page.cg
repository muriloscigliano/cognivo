root = Stack([header, plans, comparison, faq], "column", "xl")
header = Stack([title, subtitle], "column", "sm", "center")
title = TextContent("Simple, Transparent Pricing", "3xl", "bold", "default", "h1", "center")
subtitle = TextContent("Choose the plan that works for your team. All plans include a 14-day free trial.", "lg", "normal", "muted", "p", "center")
plans = Stack([starterCard, proCard, enterpriseCard], "row", "md")
starterCard = Card([starterContent], "outlined", "lg")
starterContent = Stack([starterName, starterPrice, starterDesc, starterFeatures, starterBtn], "column", "md")
starterName = TextContent("Starter", "xl", "bold")
starterPrice = Stack([starterAmount, starterPeriod], "row", "xs", "baseline")
starterAmount = TextContent("$29", "3xl", "bold")
starterPeriod = TextContent("/month", "sm", "normal", "muted")
starterDesc = TextContent("Perfect for small teams getting started with AI analytics.", "sm", "normal", "muted")
starterFeatures = List(starterFeatureItems, "bullet")
starterFeatureItems = [{title: "Up to 5 team members"}, {title: "10,000 events/month"}, {title: "Basic dashboards"}, {title: "Email support"}, {title: "7-day data retention"}]
starterBtn = Button("Start Free Trial", "secondary", "lg", "normal", false, false, true)
proCard = Card([proBadge, proContent], "elevated", "lg")
proBadge = Badge("Most Popular", "accent", "md")
proContent = Stack([proName, proPrice, proDesc, proFeatures, proBtn], "column", "md")
proName = TextContent("Professional", "xl", "bold", "accent")
proPrice = Stack([proAmount, proPeriod], "row", "xs", "baseline")
proAmount = TextContent("$99", "3xl", "bold")
proPeriod = TextContent("/month", "sm", "normal", "muted")
proDesc = TextContent("For growing teams that need advanced analytics and collaboration.", "sm", "normal", "muted")
proFeatures = List(proFeatureItems, "bullet")
proFeatureItems = [{title: "Up to 25 team members"}, {title: "100,000 events/month"}, {title: "Advanced dashboards"}, {title: "Priority support"}, {title: "30-day data retention"}, {title: "Custom reports"}, {title: "API access"}]
proBtn = Button("Start Free Trial", "primary", "lg", "normal", false, false, true)
enterpriseCard = Card([enterpriseContent], "outlined", "lg")
enterpriseContent = Stack([entName, entPrice, entDesc, entFeatures, entBtn], "column", "md")
entName = TextContent("Enterprise", "xl", "bold")
entPrice = TextContent("Custom", "3xl", "bold")
entDesc = TextContent("For large organizations with custom requirements and dedicated support.", "sm", "normal", "muted")
entFeatures = List(entFeatureItems, "bullet")
entFeatureItems = [{title: "Unlimited team members"}, {title: "Unlimited events"}, {title: "Custom dashboards"}, {title: "Dedicated support"}, {title: "Unlimited retention"}, {title: "Custom integrations"}, {title: "SLA guarantee"}, {title: "SOC2 compliance"}]
entBtn = Button("Contact Sales", "secondary", "lg", "normal", false, false, true)
comparison = Card([compTitle, compTable], "outlined", "md")
compTitle = TextContent("Feature Comparison", "xl", "semibold")
compTable = Table(compCols, compRows, true)
compCols = [{key: "feature", label: "Feature"}, {key: "starter", label: "Starter", align: "center"}, {key: "pro", label: "Professional", align: "center"}, {key: "enterprise", label: "Enterprise", align: "center"}]
compRows = [["Team members", "5", "25", "Unlimited"], ["Events/month", "10K", "100K", "Unlimited"], ["Dashboards", "Basic", "Advanced", "Custom"], ["Data retention", "7 days", "30 days", "Unlimited"], ["API access", "—", "Yes", "Yes"], ["Custom reports", "—", "Yes", "Yes"], ["SSO", "—", "—", "Yes"], ["SLA", "—", "—", "Yes"]]
faq = Stack([faqTitle, faqAccordion], "column", "md")
faqTitle = TextContent("Frequently Asked Questions", "xl", "semibold")
faqAccordion = Accordion(faqItems)
faqItems = [{value: "trial", trigger: "How does the free trial work?", content: "All plans include a 14-day free trial with full access to features. No credit card required."}, {value: "upgrade", trigger: "Can I upgrade or downgrade anytime?", content: "Yes, you can change your plan at any time. Changes take effect at the start of your next billing cycle."}, {value: "cancel", trigger: "What happens when I cancel?", content: "You retain access until the end of your billing period. Data is kept for 30 days after cancellation."}, {value: "support", trigger: "What kind of support do you offer?", content: "Starter plans get email support. Professional gets priority email and chat. Enterprise gets a dedicated account manager."}]