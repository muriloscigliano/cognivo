root = Stack([breadcrumb, productLayout], "column", "md")
breadcrumb = TextContent("Home / Electronics / Headphones / WH-1000XM5", "xs", "normal", "muted")
productLayout = Stack([gallery, details], "row", "xl")
gallery = Stack([mainImage, thumbs], "column", "sm")
mainImage = ImageBlock("https://picsum.photos/600/600", "Sony WH-1000XM5", "", "", "1:1")
thumbs = ImageGallery(thumbImages, 4)
thumbImages = [{src: "https://picsum.photos/150/150?1", alt: "Front view"}, {src: "https://picsum.photos/150/150?2", alt: "Side view"}, {src: "https://picsum.photos/150/150?3", alt: "Folded"}, {src: "https://picsum.photos/150/150?4", alt: "Case"}]
details = Stack([productHeader, rating, price, colorPicker, sizePicker, addToCart, features, specs], "column", "md")
productHeader = Stack([productTitle, productBrand], "column", "xs")
productTitle = TextContent("Sony WH-1000XM5 Wireless Noise Cancelling Headphones", "2xl", "bold")
productBrand = TextContent("Sony", "sm", "medium", "accent")
rating = Stack([ratingBadge, ratingText], "row", "sm", "center")
ratingBadge = Badge("4.8 ★", "success", "md")
ratingText = TextContent("1,247 reviews", "sm", "normal", "muted")
price = Stack([currentPrice, originalPrice, discount], "row", "sm", "baseline")
currentPrice = TextContent("$328.00", "3xl", "bold")
originalPrice = TextContent("$399.99", "lg", "normal", "muted")
discount = Badge("-18%", "danger", "sm")
colorPicker = Stack([colorLabel, colorOptions], "column", "sm")
colorLabel = TextContent("Color", "sm", "semibold")
colorOptions = Stack([blackRadio, silverRadio, midnightRadio], "row", "sm")
blackRadio = Radio("Black", "", "color", "black", true)
silverRadio = Radio("Silver", "", "color", "silver")
midnightRadio = Radio("Midnight Blue", "", "color", "midnight")
sizePicker = Stack([sizeLabel, sizeNote], "column", "xs")
sizeLabel = TextContent("One Size", "sm", "semibold")
sizeNote = TextContent("Adjustable headband fits all sizes", "xs", "normal", "muted")
addToCart = Stack([cartBtn, wishlistBtn], "row", "sm")
cartBtn = Button("Add to Cart", "primary", "lg", "normal", false, false, true)
wishlistBtn = Button("♡ Wishlist", "secondary", "lg")
features = Card([featuresContent], "filled", "md")
featuresContent = Stack([featTitle, featList], "column", "sm")
featTitle = TextContent("Key Features", "lg", "semibold")
featList = List(featureItems, "bullet")
featureItems = [{title: "Industry-leading noise cancellation", subtitle: "Auto NC Optimizer adapts to your environment"}, {title: "30-hour battery life", subtitle: "Quick charge: 3 min for 3 hours of playback"}, {title: "Crystal-clear calls", subtitle: "Precise Voice Pickup with 4 beamforming microphones"}, {title: "Multipoint connection", subtitle: "Connect to 2 devices simultaneously"}, {title: "Ultra-comfortable design", subtitle: "Lighter weight and softer ear cushions"}]
specs = Card([specsContent], "outlined", "md")
specsContent = Stack([specsTitle, specsTable], "column", "sm")
specsTitle = TextContent("Specifications", "lg", "semibold")
specsTable = Table(specCols, specRows)
specCols = [{key: "spec", label: "Specification"}, {key: "value", label: "Value"}]
specRows = [["Driver Size", "30mm"], ["Frequency Response", "4Hz-40,000Hz"], ["Impedance", "48 ohm"], ["Weight", "250g"], ["Bluetooth", "5.2"], ["Battery", "30 hours (NC on)"], ["Charging", "USB-C, 3.5mm"], ["Water Resistance", "—"]]