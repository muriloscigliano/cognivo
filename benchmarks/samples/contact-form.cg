root = Stack([title, form], "column", "lg")
title = TextContent("Contact Us", "2xl", "bold")
form = Form([nameField, emailField, phoneField, subjectField, messageField, buttons], "contact", "md")
nameField = Stack([nameLabel, nameInput], "column", "xs")
nameLabel = Label("Full Name", "", "", true)
nameInput = Input("Your full name", "name", "text")
emailField = Stack([emailLabel, emailInput], "column", "xs")
emailLabel = Label("Email", "", "", true)
emailInput = Input("you@example.com", "email", "email")
phoneField = Stack([phoneLabel, phoneInput], "column", "xs")
phoneLabel = Label("Phone", "", "", true)
phoneInput = Input("+1 555 123 4567", "phone", "tel")
subjectField = Stack([subjectLabel, subjectSelect], "column", "xs")
subjectLabel = Label("Subject", "", "", true)
subjectSelect = Select(subjectOptions, "Select a subject...", "subject")
subjectOptions = [{value: "general", label: "General inquiry"}, {value: "support", label: "Support"}, {value: "sales", label: "Sales"}, {value: "billing", label: "Billing"}, {value: "feedback", label: "Feedback"}]
messageField = Stack([msgLabel, msgInput], "column", "xs")
msgLabel = Label("Message", "", "", true)
msgInput = Textarea("How can we help?", "message", 6)
buttons = ButtonGroup([submitBtn, cancelBtn], "row")
submitBtn = Button("Submit", "primary")
cancelBtn = Button("Cancel", "secondary")