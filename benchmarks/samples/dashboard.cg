root = Stack([header, kpis, charts, table], "column", "lg")
header = Stack([title, subtitle], "column", "xs")
title = TextContent("Product Analytics Dashboard", "3xl", "bold")
subtitle = TextContent("Real-time metrics and insights for Q4 2024", "md", "normal", "muted")
kpis = Stack([kpi1, kpi2, kpi3, kpi4], "row", "md")
kpi1 = MetricCard("Total Revenue", "$2.4M", "+18.2%", "up")
kpi2 = MetricCard("Active Users", "12,847", "+5.3%", "up")
kpi3 = MetricCard("Churn Rate", "1.8%", "-0.3%", "down")
kpi4 = MetricCard("NPS Score", "72", "+4pts", "up")
charts = Stack([revenueChart, categoryChart], "row", "md")
revenueChart = Card([revTitle, revChart], "outlined", "md")
revTitle = TextContent("Monthly Revenue", "lg", "semibold")
revChart = Chart(revData, "area", "", "", 220, true, true, true)
revData = [{label: "Jul", value: 180}, {label: "Aug", value: 195}, {label: "Sep", value: 210}, {label: "Oct", value: 198}, {label: "Nov", value: 225}, {label: "Dec", value: 240}]
categoryChart = Card([catTitle, catChart], "outlined", "md")
catTitle = TextContent("Revenue by Category", "lg", "semibold")
catChart = Chart(catData, "donut", "", "", 220)
catData = [{label: "Enterprise", value: 1200000}, {label: "SMB", value: 680000}, {label: "Self-serve", value: 520000}]
table = Card([tblTitle, tbl], "outlined", "md")
tblTitle = TextContent("Top Products", "lg", "semibold")
tbl = Table(tblCols, tblRows, true)
tblCols = [{key: "product", label: "Product"}, {key: "revenue", label: "Revenue", align: "right", sortable: true}, {key: "users", label: "Users", align: "right", sortable: true}, {key: "growth", label: "Growth", align: "right", sortable: true}]
tblRows = [["Analytics Pro", "$840K", "3,241", "+24%"], ["Dashboard Lite", "$520K", "5,892", "+12%"], ["API Gateway", "$380K", "1,456", "+8%"], ["Data Pipeline", "$310K", "987", "+31%"], ["Auth Service", "$250K", "2,341", "+6%"]]