root = Stack([title, tbl])
title = TextContent("Employees (Sample)", "2xl", "bold")
tbl = Table(cols, rows)
cols = [{key: "name", label: "Name"}, {key: "dept", label: "Department"}, {key: "salary", label: "Salary", align: "right", sortable: true}, {key: "yoy", label: "YoY (%)", align: "right", sortable: true}]
rows = [["Ava Patel", "Engineering", 132000, 6.5], ["Marcus Lee", "Sales", 98000, 4.2], ["Sofia Ramirez", "Marketing", 105000, 3.1], ["Ethan Brooks", "Finance", 118500, 5.0], ["Nina Chen", "HR", 89000, 2.4]]