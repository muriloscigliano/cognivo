---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI-native component library with cognitive psychology integration' } = Astro.props;
---

<!DOCTYPE html>
<!-- No hardcoded data-theme — the inline script below + the
     astro:before-swap listener apply the saved theme so navigations don't
     reset it. Keeping it hardcoded would let Astro's view-transition swap
     overwrite the user's saved theme on every navigation. -->
<html lang="en" style="scroll-behavior: smooth;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Cognivo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    // Apply saved theme BEFORE any CSS loads — prevents a flash on first
    // load. For subsequent client-side navigations, the astro:before-swap
    // listener (registered later) reapplies the theme to the incoming
    // <html> element so user choice survives view transitions.
    (function() {
      try {
        var t = localStorage.getItem('cognivo-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
    // Survive Astro view transitions — the incoming document's <html>
    // attribute is empty (we removed the hardcoded data-theme), so we
    // re-apply from localStorage on every page swap.
    document.addEventListener('astro:before-swap', function(e) {
      try {
        var t = localStorage.getItem('cognivo-theme') || 'dark';
        // @ts-ignore — newDocument is the about-to-be-swapped-in document
        if (e.newDocument && e.newDocument.documentElement) {
          e.newDocument.documentElement.setAttribute('data-theme', t);
        }
      } catch (err) {}
    });
  </script>
  <style>
    /* Force solid backgrounds immediately to prevent flash on navigation */
    html, body { background: var(--bg, #09090b); }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <ClientRouter />
  <style is:global>
    :root {
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      --font-mono: 'Geist Mono', 'SF Mono', 'Cascadia Code', ui-monospace, monospace;
      --radius: 10px;
      --radius-pill: 9999px;
      --max-width: 1400px;
    }

    /* Dark theme (default) */
    [data-theme="dark"] {
      --bg: #09090b;
      --bg-subtle: #111113;
      --bg-muted: #18181b;
      --border: #1e1e22;
      --border-subtle: rgba(255,255,255,0.04);
      --border-hover: #2e2e33;
      --border-strong: rgba(255,255,255,0.15);
      --fg: #fafafa;
      --fg-2: #a1a1aa;
      --fg-3: #9999a2;
      --fg-4: #828289;
      --text-1: var(--fg); --text-2: var(--fg-2); --text-3: var(--fg-3); --text-4: var(--fg-4);
      --accent: #dfff61;
      --accent-dim: rgba(223,255,97,0.07);
      --accent-muted: rgba(223,255,97,0.12);
      --shadow-card: 0 1px 2px rgba(0,0,0,0.4);
      --shadow-card-hover: 0 4px 12px rgba(0,0,0,0.5);
      --row-hover: rgba(255,255,255,0.02);
      --dot-color: rgba(255,255,255,0.06);
    }

    /* Light theme */
    [data-theme="light"] {
      --bg: #ffffff;
      --bg-subtle: #f4f4f5;
      --bg-muted: #e4e4e7;
      --border: #e4e4e7;
      --border-subtle: rgba(0,0,0,0.04);
      --border-hover: #a1a1aa;
      --border-strong: rgba(0,0,0,0.12);
      --fg: #09090b;
      --fg-2: #52525b;
      --fg-3: #5f5f68;
      --fg-4: #71717a;
      --text-1: var(--fg); --text-2: var(--fg-2); --text-3: var(--fg-3); --text-4: var(--fg-4);
      --accent: #4d7c0f;
      --accent-dim: rgba(77,124,15,0.06);
      --accent-muted: rgba(77,124,15,0.1);
      --shadow-card: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-card-hover: 0 4px 12px rgba(0,0,0,0.08);
      --row-hover: rgba(0,0,0,0.02);
      --dot-color: rgba(0,0,0,0.09);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      font-size: 16px;
      color: var(--fg);
      background: var(--bg);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    a:not([class]):hover { color: var(--accent); }

    code {
      font-family: var(--font-mono);
      font-size: 0.85em;
      background: var(--bg-muted);
      padding: 2px 7px;
      border-radius: 5px;
      color: var(--accent);
    }

    pre {
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      padding: 16px 20px;
      border-radius: var(--radius);
      overflow-x: auto;
      font-size: 13px;
      line-height: 1.7;
      margin: 16px 0;
    }
    pre code { background: none; padding: 0; font-size: inherit; color: var(--fg-2); }

    /* Global accent touches for doc content */
    strong { color: var(--fg); }
    h1 code, h2 code, h3 code { font-size: 0.85em; }
    hr { border: none; border-top: 1px solid var(--border); margin: 32px 0; }

    ::selection { background: rgba(223,255,97,0.18); color: #fff; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    * { scrollbar-width: thin; scrollbar-color: #27272a transparent; }
  </style>
  <slot name="head" />
</head>
<body>
  <slot />
  <script>
    // Importing as a namespace + reading a property prevents Rollup/Vite from
    // tree-shaking the side-effect-only @customElement registrations away in
    // production builds, even if a bundler ignores the package's sideEffects
    // hint. See: https://rollupjs.org/configuration-options/#treeshake
    import * as cognivoComponents from '@cognivo/components';
    import '@cognivo/tokens/dist/index.css';
    // @ts-expect-error — exposing for runtime debugging + side-effect anchor.
    (globalThis as { __cognivo?: unknown }).__cognivo = cognivoComponents;
  </script>
</body>
</html>
