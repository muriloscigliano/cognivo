---
import BaseLayout from './BaseLayout.astro';
import { sidebar, type SidebarItem, type SidebarGroup, type SidebarLink } from '../data/sidebar';

interface Props { title: string; }

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isLink(item: SidebarItem): item is SidebarLink { return !('items' in item); }
function match(href: string) { return path.replace(/\/$/, '') === href.replace(/\/$/, ''); }
function groupOpen(g: SidebarGroup): boolean {
  if (g.href && match(g.href)) return true;
  return g.items.some(i => isLink(i) ? match(i.href) : groupOpen(i));
}
---

<BaseLayout title={title}>
  <!-- Header -->
  <header class="hd">
    <div class="hd-in">
      <a href="/" class="logo">Cognivo</a>
      <span class="sep" />
      <span class="ctx">Docs</span>
      <span class="ver">v0.3</span>
    </div>
  </header>

  <div class="shell">
    <!-- Sidebar -->
    <aside class="sb">
      <nav>
        {sidebar.map(item => {
          if (isLink(item)) {
            return <a href={item.href} class:list={['sl', { on: match(item.href) }]}>{item.label}</a>;
          }
          const g = item as SidebarGroup;
          const open = groupOpen(g);
          return (
            <div class:list={['sg', { open }]}>
              {g.href
                ? <a href={g.href} class:list={['sh', { on: match(g.href) }]}>{g.label}<svg class="ch" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.5 2l3 3-3 3"/></svg></a>
                : <button class="sh">{g.label}<svg class="ch" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.5 2l3 3-3 3"/></svg></button>
              }
              <div class="sk">
                {g.items.map(sub => {
                  if (isLink(sub)) return <a href={sub.href} class:list={['sl n', { on: match(sub.href) }]}>{sub.label}</a>;
                  const sg = sub as SidebarGroup;
                  return (
                    <details open={groupOpen(sg)}>
                      <summary class="sc">{sg.label}</summary>
                      <div class="sci">
                        {sg.items.map(leaf => isLink(leaf) ? <a href={leaf.href} class:list={['sl lf', { on: match(leaf.href) }]}>{leaf.label}</a> : null)}
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
          );
        })}
      </nav>
    </aside>

    <!-- Content -->
    <main class="mn"><article><slot /></article></main>

    <!-- TOC -->
    <aside class="toc" id="toc">
      <div class="tw">
        <p class="tl">On this page</p>
        <nav id="tn"></nav>
      </div>
    </aside>
  </div>

  <script>
    const mn = document.querySelector('.mn article');
    const tn = document.getElementById('tn');
    if (mn && tn) {
      const hh = mn.querySelectorAll('h2, h3');
      hh.forEach((h, i) => {
        if (!h.id) h.id = 's' + i;
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent || '';
        a.className = h.tagName === 'H3' ? 'ti d3' : 'ti';
        tn.appendChild(a);
      });
      const obs = new IntersectionObserver(ee => {
        ee.forEach(e => { if (e.isIntersecting) {
          tn.querySelectorAll('.ti').forEach(l => l.classList.remove('on'));
          tn.querySelector('a[href="#'+e.target.id+'"]')?.classList.add('on');
        }});
      }, { rootMargin: '-64px 0px -75% 0px' });
      hh.forEach(h => obs.observe(h));
    }
    document.querySelectorAll('pre').forEach(p => {
      const b = document.createElement('button');
      b.className = 'cp'; b.textContent = 'Copy';
      b.onclick = () => { navigator.clipboard.writeText(p.querySelector('code')?.textContent||p.textContent||''); b.textContent='Copied'; setTimeout(()=>b.textContent='Copy',1200); };
      p.style.position = 'relative'; p.appendChild(b);
    });
    document.querySelectorAll('button.sh').forEach(b => {
      b.addEventListener('click', () => b.closest('.sg')?.classList.toggle('open'));
    });
  </script>

  <style>
    /* ── Header ── */
    .hd {
      position: sticky; top: 0; z-index: 50; height: 48px;
      border-bottom: 1px solid var(--border);
      background: rgba(10,10,10,0.92);
      backdrop-filter: blur(12px);
    }
    .hd-in {
      max-width: 1400px; margin: 0 auto;
      padding: 0 24px; height: 100%;
      display: flex; align-items: center; gap: 12px;
    }
    .logo { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
    .sep { width: 1px; height: 16px; background: var(--border-hover); }
    .ctx { font-size: 14px; color: var(--fg-3); }
    .ver { margin-left: auto; font: 500 12px var(--font-mono); color: var(--fg-3); }

    /* ── Grid ── */
    .shell {
      display: grid;
      grid-template-columns: 240px 1fr 200px;
      max-width: 1400px; margin: 0 auto;
      min-height: calc(100vh - 48px);
    }

    /* ── Sidebar ── */
    .sb {
      position: sticky; top: 48px; height: calc(100vh - 48px);
      overflow-y: auto; padding: 16px 12px 48px;
      border-right: 1px solid var(--border);
      scrollbar-width: none;
    }
    .sb::-webkit-scrollbar { display: none; }

    .sl {
      display: block; padding: 6px 12px;
      font-size: 14px; color: var(--fg-2);
      border-radius: 6px; transition: color 80ms;
    }
    .sl:hover { color: var(--fg); }
    .sl.on { color: var(--fg); background: var(--accent-dim); }
    .sl.n { padding-left: 16px; }
    .sl.lf { padding: 4px 12px 4px 22px; font-size: 14px; color: var(--fg-3); }
    .sl.lf:hover { color: var(--fg-2); }
    .sl.lf.on { color: var(--accent); background: var(--accent-dim); }

    .sg { margin-top: 4px; }
    .sh {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; padding: 6px 12px;
      font: 500 14px var(--font-sans);
      color: var(--fg-2); background: none; border: none;
      border-radius: 6px; cursor: pointer;
    }
    a.sh { text-decoration: none; }
    .sh:hover { color: var(--fg); }
    a.sh.on { color: var(--accent); }
    .ch { transition: transform 120ms; flex-shrink: 0; }
    .sg.open > .sh .ch, .sg.open > a.sh .ch { transform: rotate(90deg); }
    .sk { display: none; padding: 2px 0; }
    .sg.open > .sk { display: block; }

    .sc {
      padding: 8px 12px 4px 16px;
      font-size: 12px; font-weight: 500;
      color: var(--fg-3); cursor: pointer;
      list-style: none;
    }
    .sc::-webkit-details-marker { display: none; }
    .sci { padding-bottom: 6px; }

    /* ── Content ── */
    .mn { padding: 40px 48px 96px; overflow-x: hidden; }
    .mn article { max-width: 650px; }

    /* ── TOC ── */
    .toc {
      position: sticky; top: 48px; height: calc(100vh - 48px);
      overflow-y: auto; padding: 28px 16px 40px 0;
      scrollbar-width: none;
    }
    .toc::-webkit-scrollbar { display: none; }
    .tw { padding-left: 20px; border-left: 1px solid var(--border); }
    .tl { font-size: 12px; font-weight: 500; color: var(--fg-3); margin-bottom: 12px; }

    .ti {
      display: block; padding: 4px 0;
      font-size: 13px; color: var(--fg-3);
      transition: color 80ms; line-height: 1.5;
    }
    .ti:hover { color: var(--fg-2); }
    .ti.on { color: var(--fg); }
    .ti.d3 { padding-left: 12px; }

    /* ── Copy button ── */
    .cp {
      position: absolute; top: 10px; right: 10px;
      font: 500 12px var(--font-sans);
      padding: 4px 10px; border-radius: 5px;
      border: 1px solid var(--border);
      background: var(--bg-muted); color: var(--fg-3);
      cursor: pointer; opacity: 0; transition: opacity 120ms;
    }
    pre:hover .cp { opacity: 1; }
    .cp:hover { color: var(--fg-2); border-color: var(--border-hover); }

    /* ── Responsive ── */
    @media (max-width: 1100px) {
      .shell { grid-template-columns: 240px 1fr; }
      .toc { display: none; }
    }
    @media (max-width: 768px) {
      .shell { grid-template-columns: 1fr; }
      .sb { display: none; }
      .mn { padding: 24px 20px 60px; }
    }
  </style>
</BaseLayout>
