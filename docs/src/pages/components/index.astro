---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { registry, categories } from '../../data/components';

const grouped = categories.map(cat => ({
  ...cat,
  items: registry.filter(c => c.category === cat.id),
})).filter(g => g.items.length > 0);

const total = registry.length;
---

<DocsLayout title="Components">
  <h1>Components</h1>
  <p class="sub">{total} web components built with Lit 3 and Shadow DOM. Works everywhere.</p>

  <pre><code>pnpm add @cognivo/components @cognivo/tokens</code></pre>

  {grouped.map(g => (
    <section id={g.id}>
      <h2>{g.label} <span class="cnt">{g.items.length}</span></h2>
      <div class="grid">
        {g.items.map(comp => (
          <a href={`/components/${comp.tag}`} class="card">
            <span class="card-name">{comp.name}</span>
            <span class="card-tag">&lt;{comp.tag}&gt;</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <style>
    h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 6px; }
    .sub { font-size: 15px; color: var(--text-2); margin-bottom: 24px; }

    h2 {
      font-size: 16px; font-weight: 600;
      margin: 36px 0 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .cnt { font-size: 12px; font-weight: 500; color: var(--text-3); font-family: var(--font-mono); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 6px;
    }

    .card {
      display: flex; flex-direction: column; gap: 2px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color 120ms;
    }
    .card:hover { border-color: var(--border-strong); }
    .card-name { font-size: 13px; font-weight: 500; }
    .card-tag { font: 12px var(--font-mono); color: var(--text-3); }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</DocsLayout>
