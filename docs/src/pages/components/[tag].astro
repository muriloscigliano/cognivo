---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { registry } from '../../data/components';
import type { ComponentMeta } from '../../data/components';

// Foundation components only — AI components live at /ai/[tag],
// cognitive-bias wrappers live at /biases/[name].
export function getStaticPaths() {
  return registry
    .filter(comp => !comp.category.startsWith('ai-') && comp.category !== 'bias')
    .map(comp => ({ params: { tag: comp.tag }, props: { comp } }));
}

const { comp } = Astro.props as { comp: ComponentMeta };
const cls = comp.tag.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join('');
// Prev/next navigation within the same category, sorted alphabetically
// to match the sidebar and index page order.
const same = registry
  .filter(c => c.category === comp.category)
  .sort((a, b) => a.name.localeCompare(b.name));
const i = same.findIndex(c => c.tag === comp.tag);
const prev = i > 0 ? same[i-1] : null;
const next = i < same.length-1 ? same[i+1] : null;
function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
---

<DocsLayout title={comp.name}>
  <p class="bc"><a href="/components">Components</a> <span>/</span> {comp.name}</p>

  <h1>{comp.name}</h1>
  <p class="desc">{comp.description}</p>

  <div class="badges">
    <span class="badge">{comp.category}</span>
    {comp.since && <span class="badge">{comp.since}</span>}
  </div>

  <h2 id="playground">Playground</h2>
  <div id="playground-mount"></div>

  {comp.examples.length > 0 && (
    <>
      <h2 id="examples">Examples</h2>
      <div class="examples">
        {comp.examples.map((ex, idx) => (
          <div class="ex-card">
            <div class="ex-header">{ex.label}</div>
            <div class="ex-live" data-ex-idx={idx} set:html={ex.html} />
            <div class="ex-code-wrap">
              <pre class="ex-code" tabindex="0"><code set:html={esc(ex.html.trim())} /></pre>
              <button class="ex-copy">Copy</button>
            </div>
          </div>
        ))}
      </div>
    </>
  )}

  <h2 id="import">Import</h2>
  <pre><code>{`import { ${cls} } from '@cognivo/components';`}</code></pre>
  <pre><code>{`// Or tree-shake: import '@cognivo/components/${comp.tag}';`}</code></pre>
  <p class="hint">Per-component imports ship only that component (~8 kB gzip).</p>

  {comp.props.length > 0 && (
    <>
      <h2 id="props">API Reference</h2>
      <div class="tb">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            {comp.props.map(p => (
              <tr>
                <td><code class="pn">{p.name}</code></td>
                <td class="ty">{p.type}</td>
                <td class="df">{p.default || '—'}</td>
                <td>{p.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {comp.events.length > 0 && (
    <>
      <h2 id="events">Events</h2>
      <div class="tb">
        <table>
          <thead><tr><th>Event</th><th>Detail</th><th>Description</th></tr></thead>
          <tbody>
            {comp.events.map(ev => (
              <tr>
                <td><code class="pn">{ev.name}</code></td>
                <td class="ty">{ev.detail}</td>
                <td>{ev.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <nav class="pnav">
    {prev ? <a href={`/components/${prev.tag}`} class="pc"><span class="pd">&larr; Previous</span><span class="pname">{prev.name}</span></a> : <div/>}
    {next ? <a href={`/components/${next.tag}`} class="pc r"><span class="pd">Next &rarr;</span><span class="pname">{next.name}</span></a> : <div/>}
  </nav>

  <script src="../../scripts/playground.ts"></script>

  <style is:global>
    @import '../../styles/playground.css';
  </style>

  <style>
    .bc { font-size: 14px; color: var(--fg-3); margin-bottom: 24px; }
    .bc a { color: var(--fg-3); } .bc a:hover { color: var(--accent); }
    .bc span { margin: 0 6px; }

    h1 { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; margin-bottom: 12px; }

    .desc { font-size: 16px; color: var(--fg-2); line-height: 1.7; margin-bottom: 12px; }
    .hint { font-size: 13px; color: var(--fg-3); margin: 8px 0 0; }

    .badges { display: flex; gap: 8px; margin-bottom: 40px; }
    .badge {
      font: 600 11px/1 var(--font-mono);
      padding: 5px 12px; border-radius: 6px;
      text-transform: uppercase; letter-spacing: 0.04em;
      background: var(--accent-dim); color: var(--accent);
      border: 1px solid var(--accent-muted);
    }

    h2 {
      font-size: 18px; font-weight: 600; letter-spacing: -0.01em;
      margin: 40px 0 16px; padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    h2::before {
      content: '';
      display: inline-block;
      width: 3px; height: 18px;
      background: var(--accent);
      border-radius: 2px;
      margin-right: 10px;
      vertical-align: middle;
    }

    /* ── Examples ── */
    .examples { display: flex; flex-direction: column; gap: 16px; }

    .ex-card {
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .ex-header {
      padding: 10px 16px;
      font: 600 12px/1 var(--font-sans);
      color: var(--fg-3);
      border-bottom: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    :global(.ex-live) {
      padding: 32px 24px;
      display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
      background: var(--bg);
      background-image: radial-gradient(circle, var(--dot-color) 0.75px, transparent 1px);
      background-size: 16px 16px;
    }
    .ex-code-wrap {
      position: relative;
      border-top: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    .ex-code {
      margin: 0; border: none; border-radius: 0;
      padding: 14px 16px;
      font: 12px/1.7 var(--font-mono);
      color: var(--fg-3);
      overflow-x: auto; white-space: pre;
    }
    .ex-copy {
      position: absolute; top: 8px; right: 8px;
      font: 500 10px var(--font-sans);
      padding: 3px 10px; border-radius: 4px;
      border: 1px solid var(--border);
      background: var(--bg-muted); color: var(--fg-3);
      cursor: pointer; opacity: 0; transition: opacity 120ms;
    }
    .ex-code-wrap:hover .ex-copy { opacity: 1; }
    .ex-copy:hover { color: var(--fg-2); border-color: var(--border-hover); }

    /* ── Tables ── */
    .tb { border: 1px solid var(--border); border-radius: 10px; overflow-x: auto; margin-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; }
    th {
      text-align: left; padding: 10px 16px;
      font: 600 10px/1 var(--font-sans);
      color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.06em;
      background: var(--bg-subtle); border-bottom: 1px solid var(--border);
    }
    td {
      padding: 10px 16px; font-size: 14px;
      border-bottom: 1px solid var(--border); color: var(--fg-2);
      vertical-align: top; line-height: 1.5;
    }
    tr:last-child td { border-bottom: none; }
    .pn { background: none; padding: 0; color: var(--fg); font-weight: 500; font-size: 14px; }
    .ty { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); }
    .df { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); }

    /* ── Prev/Next ── */
    .pnav { display: flex; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); }
    .pc { display: flex; flex-direction: column; gap: 4px; padding: 12px 16px; border: 1px solid var(--border); border-radius: 10px; transition: border-color 120ms; }
    .pc:hover { border-color: var(--accent); background: var(--accent-dim); }
    .pc.r { text-align: right; margin-left: auto; }
    .pd { font-size: 13px; color: var(--fg-3); }
    .pname { font-size: 15px; font-weight: 500; }
  </style>
</DocsLayout>
