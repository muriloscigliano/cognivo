---
import DocsLayout from '../../layouts/DocsLayout.astro';

const tiers = [
  {
    name: 'Tier 1: Core Primitives',
    desc: 'Raw values with no semantic meaning. The building blocks.',
    tokens: '~310 tokens',
    examples: [
      { token: '--cg-gray-500', value: '#737373', desc: 'Gray palette midpoint' },
      { token: '--cg-spacing-16', value: '16px', desc: 'Base spacing unit' },
      { token: '--cg-font-size-md', value: '16px', desc: 'Medium body text' },
      { token: '--cg-border-radius-150', value: '12px', desc: 'Medium radius' },
      { token: '--cg-brand-ai-accent', value: '#DFFF61', desc: 'Brand lime-yellow' },
    ],
  },
  {
    name: 'Tier 2: Semantic Tokens',
    desc: 'Map primitives to UI intent. These are what you use in components.',
    tokens: '~700+ tokens',
    examples: [
      { token: '--cg-color-action-primary-background-default', value: 'Lime accent', desc: 'Primary button fill' },
      { token: '--cg-color-status-success-text', value: 'Green', desc: 'Success state text' },
      { token: '--cg-color-surface-container-background', value: 'Dark gray', desc: 'Page background' },
      { token: '--cg-typography-heading-h1-fontSize', value: '48px', desc: 'H1 heading size' },
      { token: '--cg-ai-confidence-high-color', value: 'Teal', desc: 'High confidence indicator' },
    ],
  },
  {
    name: 'Tier 3: Component Tokens',
    desc: 'Component-specific sizing and spacing. Used internally by components.',
    tokens: '~102 tokens',
    examples: [
      { token: '--cg-component-button-height-md', value: '40px', desc: 'Medium button height' },
      { token: '--cg-component-input-height-md', value: '44px', desc: 'Medium input height' },
      { token: '--cg-component-card-radius', value: '12px', desc: 'Card border radius' },
      { token: '--cg-component-modal-radius', value: '16px', desc: 'Modal border radius' },
      { token: '--cg-component-badge-height-md', value: '24px', desc: 'Badge height' },
    ],
  },
];

const categories = [
  { name: 'AI States', count: 196, desc: 'Confidence levels, anomaly severity, thinking animation, insight types.' },
  { name: 'Borders', count: 37, desc: 'Radius (8 steps), width (4 steps), and style tokens.' },
  { name: 'Colors', count: 777, desc: 'Action, status, surface, brand, and AI state colors across light and dark themes.' },
  { name: 'Component', count: 102, desc: 'Button, input, card, modal, badge, table, and more — per-component sizing.' },
  { name: 'Elevation', count: 10, desc: '5 shadow levels with light and dark variants.' },
  { name: 'Font Base', count: 66, desc: '3 font families, 10 sizes, 9 weights, 5 line heights, 6 letter spacings.' },
  { name: 'Motion', count: 20, desc: '5 durations (0-350ms) and 5 easing curves.' },
  { name: 'Spacing', count: 37, desc: '17-step scale from 0 to 96px. Base unit: 8px.' },
  { name: 'Typography', count: 162, desc: '6 heading styles, 5 body, 3 label sizes, caption, code, and overline presets.' },
];

const spacingScale = [0, 1, 2, 4, 6, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96];

const elevations = [
  { level: 1, use: 'Cards, inputs', shadow: '0 1px 3px' },
  { level: 2, use: 'Hover states, tooltips', shadow: '0 4px 6px' },
  { level: 3, use: 'Dropdowns, popovers', shadow: '0 10px 15px' },
  { level: 4, use: 'Modals', shadow: '0 20px 25px' },
  { level: 5, use: 'Drawers, command palette', shadow: '0 25px 50px' },
];

const motionDurations = [
  { name: 'instant', value: '0ms', use: 'Immediate feedback' },
  { name: 'fast', value: '80ms', use: 'Micro-interactions' },
  { name: 'normal', value: '150ms', use: 'Standard transitions' },
  { name: 'slow', value: '250ms', use: 'Complex animations' },
  { name: 'slower', value: '350ms', use: 'Page transitions' },
];

const motionEasings = [
  { name: 'default', curve: 'cubic-bezier(0.4, 0, 0.2, 1)', use: 'Standard' },
  { name: 'enter', curve: 'cubic-bezier(0, 0, 0.2, 1)', use: 'Elements appearing' },
  { name: 'exit', curve: 'cubic-bezier(0.4, 0, 1, 1)', use: 'Elements leaving' },
  { name: 'bounce', curve: 'cubic-bezier(0.34, 1.56, 0.64, 1)', use: 'Spring/playful' },
  { name: 'color', curve: 'cubic-bezier(0, 0, 0.58, 1)', use: 'Color/opacity' },
];
---

<DocsLayout title="Design Tokens">
  <div class="tokens-page">
    <header class="page-header">
      <h1>Design Tokens</h1>
      <p class="subtitle">1,800+ CSS custom properties organized in a 3-tier architecture. All prefixed with <code>--cg-</code>.</p>
    </header>

    <!-- Install -->
    <section class="section">
      <h2 id="installation">Installation</h2>
      <pre><code>pnpm add @cognivo/tokens</code></pre>
      <pre style="margin-top: 8px;"><code>{`/* Import in CSS */
@import '@cognivo/tokens';

/* Or in JS */
import '@cognivo/tokens/dist/index.css';`}</code></pre>
    </section>

    <!-- Dark Mode -->
    <section class="section">
      <h2 id="darkmode">Dark Mode</h2>
      <p>All tokens respond to the <code>data-theme</code> attribute. Light is the default; dark overrides semantic tokens only.</p>
      <pre><code>{`<!-- Light theme (default) -->
<html>

<!-- Dark theme -->
<html data-theme="dark">

<!-- Toggle with JS -->
<script>
  document.documentElement.setAttribute('data-theme', 'dark');
</script>`}</code></pre>
    </section>

    <!-- Token Counts -->
    <section class="section">
      <h2 id="breakdown">Token Breakdown</h2>
      <p style="margin-bottom: 1rem; color: var(--text-2);">1,800+ tokens organized across 9 categories:</p>
      <div class="cat-grid">
        {categories.map(cat => (
          <div class="cat-card">
            <div class="cat-count">{cat.count}</div>
            <div class="cat-name">{cat.name}</div>
            <div class="cat-desc">{cat.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3-Tier System -->
    <section class="section">
      <h2 id="tiers">3-Tier Architecture</h2>
      <p style="margin-bottom: 1.5rem; color: var(--text-2);">
        Tokens follow a strict hierarchy: <strong>Tier 3 &rarr; Tier 2 &rarr; Tier 1</strong>. Always prefer higher-tier tokens.
      </p>

      {tiers.map(tier => (
        <div class="tier-block">
          <div class="tier-header">
            <h3>{tier.name}</h3>
            <span class="tier-count">{tier.tokens}</span>
          </div>
          <p class="tier-desc">{tier.desc}</p>
          <div class="token-examples">
            {tier.examples.map(ex => (
              <div class="token-row">
                <code class="token-name">{ex.token}</code>
                <span class="token-value">{ex.value}</span>
                <span class="token-desc">{ex.desc}</span>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="rule-box">
        <strong>Rule:</strong> Never use Tier 1 palette tokens (<code>--cg-gray-*</code>, <code>--cg-red-*</code>) directly in components.
        Use Tier 2 semantic tokens (<code>--cg-color-action-*</code>, <code>--cg-color-status-*</code>) instead.
      </div>
    </section>

    <!-- Spacing -->
    <section class="section">
      <h2 id="spacing">Spacing Scale</h2>
      <p style="margin-bottom: 1rem; color: var(--text-2);">17-step scale based on 8px grid. Use <code>--cg-spacing-{`{value}`}</code>.</p>
      <div class="spacing-grid">
        {spacingScale.map(s => (
          <div class="spacing-item">
            <div class="spacing-bar" style={`width: ${Math.max(s, 2)}px; height: 20px;`}></div>
            <code class="spacing-token">--cg-spacing-{s}</code>
            <span class="spacing-value">{s}px</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography -->
    <section class="section">
      <h2 id="typography">Typography</h2>
      <div class="type-block">
        <h3>Font Families</h3>
        <div class="token-examples">
          <div class="token-row">
            <code class="token-name">--cg-font-family-primary</code>
            <span class="token-value">Inter</span>
            <span class="token-desc">UI text, body copy</span>
          </div>
          <div class="token-row">
            <code class="token-name">--cg-font-family-display</code>
            <span class="token-value">Satoshi</span>
            <span class="token-desc">Headings, marketing</span>
          </div>
          <div class="token-row">
            <code class="token-name">--cg-font-family-mono</code>
            <span class="token-value">Fira Code</span>
            <span class="token-desc">Code, data, badges</span>
          </div>
        </div>
      </div>
      <div class="type-block">
        <h3>Size Scale</h3>
        <p style="color: var(--text-2); margin-bottom: 0.75rem; font-size: 0.875rem;">
          10 sizes from <code>xs</code> (12px) to <code>5xl</code> (60px). Use <code>--cg-font-size-{`{size}`}</code>.
        </p>
      </div>
      <div class="type-block">
        <h3>Typography Presets</h3>
        <p style="color: var(--text-2); font-size: 0.875rem;">
          Composite tokens for full type styles: <code>--cg-typography-heading-h1-fontSize</code>,
          <code>--cg-typography-body-large-lineHeight</code>, etc.
          Covers 6 headings, 5 body, 3 label, caption, code, and overline.
        </p>
      </div>
    </section>

    <!-- Elevation -->
    <section class="section">
      <h2 id="elevation">Elevation</h2>
      <p style="margin-bottom: 1rem; color: var(--text-2);">5-level shadow system. Automatically adjusts for dark mode.</p>
      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr><th>Level</th><th>Token</th><th>Shadow</th><th>Use</th></tr>
          </thead>
          <tbody>
            {elevations.map(e => (
              <tr>
                <td><strong>{e.level}</strong></td>
                <td><code>--cg-elevation-{e.level}</code></td>
                <td class="muted">{e.shadow}</td>
                <td>{e.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Motion -->
    <section class="section">
      <h2 id="motion">Motion</h2>
      <div class="type-block">
        <h3>Durations</h3>
        <div class="table-wrap">
          <table class="ref-table">
            <thead><tr><th>Token</th><th>Value</th><th>Use</th></tr></thead>
            <tbody>
              {motionDurations.map(d => (
                <tr>
                  <td><code>--cg-motion-duration-{d.name}</code></td>
                  <td class="muted">{d.value}</td>
                  <td>{d.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="type-block">
        <h3>Easing Curves</h3>
        <div class="table-wrap">
          <table class="ref-table">
            <thead><tr><th>Token</th><th>Curve</th><th>Use</th></tr></thead>
            <tbody>
              {motionEasings.map(e => (
                <tr>
                  <td><code>--cg-motion-easing-{e.name}</code></td>
                  <td class="muted" style="font-size: 0.75rem;">{e.curve}</td>
                  <td>{e.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="type-block">
        <h3>Advanced Easing (Transition Tokens)</h3>
        <p style="color: var(--text-2); font-size: 0.875rem; margin-bottom: 0.75rem;">
          Use <code>--cg-transition-easing-spring</code> for UI feedback (button press, toggle flip),
          <code>--cg-transition-easing-overshoot</code> for attention-grabbing entrances (badges, toasts, modals),
          <code>--cg-transition-easing-bounce</code> for tasteful pop animations (accordion expand, popover reveal),
          and <code>--cg-transition-easing-materialize</code> for content materialization (streaming text, skeleton-to-content swaps).
        </p>
        <div class="table-wrap">
          <table class="ref-table">
            <thead><tr><th>Token</th><th>Curve</th><th>Use</th></tr></thead>
            <tbody>
              <tr>
                <td><code>--cg-transition-easing-spring</code></td>
                <td class="muted" style="font-size: 0.75rem;">cubic-bezier(0.34, 1.56, 0.64, 1)</td>
                <td>UI feedback, springy snap</td>
              </tr>
              <tr>
                <td><code>--cg-transition-easing-overshoot</code></td>
                <td class="muted" style="font-size: 0.75rem;">cubic-bezier(0.68, -0.55, 0.265, 1.55)</td>
                <td>Attention-grabbing entrances</td>
              </tr>
              <tr>
                <td><code>--cg-transition-easing-bounce</code></td>
                <td class="muted" style="font-size: 0.75rem;">cubic-bezier(0.16, 1, 0.3, 1)</td>
                <td>Tasteful pop animations</td>
              </tr>
              <tr>
                <td><code>--cg-transition-easing-materialize</code></td>
                <td class="muted" style="font-size: 0.75rem;">cubic-bezier(0.16, 1, 0.3, 1)</td>
                <td>Content materialization</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- AI Tokens -->
    <section class="section">
      <h2 id="ai-tokens">AI State Tokens</h2>
      <p style="margin-bottom: 1rem; color: var(--text-2);">196 tokens for AI-specific UI states. Unique to Cognivo.</p>

      <div class="type-block">
        <h3>Confidence Levels</h3>
        <div class="token-examples">
          <div class="token-row">
            <code class="token-name">--cg-ai-confidence-high-color</code>
            <span class="token-desc">Score &ge; 80% — teal</span>
          </div>
          <div class="token-row">
            <code class="token-name">--cg-ai-confidence-medium-color</code>
            <span class="token-desc">Score 50-79% — yellow</span>
          </div>
          <div class="token-row">
            <code class="token-name">--cg-ai-confidence-low-color</code>
            <span class="token-desc">Score &lt; 50% — red</span>
          </div>
        </div>
      </div>

      <div class="type-block">
        <h3>Anomaly Detection</h3>
        <p style="color: var(--text-2); font-size: 0.875rem; margin-bottom: 0.5rem;">
          4 severity levels (critical, high, medium, low) with glow effects for visual urgency.
        </p>
      </div>

      <div class="type-block">
        <h3>Thinking Animation</h3>
        <div class="token-examples">
          <div class="token-row">
            <code class="token-name">--cg-ai-thinking-duration</code>
            <span class="token-value">1400ms</span>
            <span class="token-desc">Full cycle duration</span>
          </div>
          <div class="token-row">
            <code class="token-name">--cg-ai-thinking-dot-size</code>
            <span class="token-value">6-10px</span>
            <span class="token-desc">Dot indicator size range</span>
          </div>
        </div>
      </div>

      <div class="type-block">
        <h3>Insight Types</h3>
        <p style="color: var(--text-2); font-size: 0.875rem;">
          4 insight categories with dedicated colors and icons: explanation, forecast, classification, optimization.
        </p>
      </div>
    </section>

    <!-- New Tokens (recent additions) -->
    <section class="section">
      <h2 id="new-tokens">Recently Added Tokens</h2>
      <p style="margin-bottom: 1.5rem; color: var(--fg-2);">New tokens added in the latest release.</p>

      <div class="type-block">
        <h3>Layout & Breakpoints</h3>
        <div class="token-examples">
          <div class="token-row"><code class="token-name">--cg-layout-breakpoint-sm</code><span class="token-value">640px</span><span class="token-desc">Small screens</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-breakpoint-md</code><span class="token-value">768px</span><span class="token-desc">Medium screens</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-breakpoint-lg</code><span class="token-value">1024px</span><span class="token-desc">Large screens</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-breakpoint-xl</code><span class="token-value">1280px</span><span class="token-desc">Extra large</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-breakpoint-2xl</code><span class="token-value">1536px</span><span class="token-desc">Ultra wide</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-grid-columns</code><span class="token-value">12</span><span class="token-desc">Grid column count</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-grid-gap-md</code><span class="token-value">16px</span><span class="token-desc">Medium grid gap</span></div>
        </div>
      </div>

      <div class="type-block">
        <h3>Aspect Ratios</h3>
        <div class="token-examples">
          <div class="token-row"><code class="token-name">--cg-layout-aspect-ratio-square</code><span class="token-value">1</span><span class="token-desc">1:1</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-aspect-ratio-video</code><span class="token-value">16/9</span><span class="token-desc">Video standard</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-aspect-ratio-card</code><span class="token-value">3/2</span><span class="token-desc">Card preview</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-aspect-ratio-portrait</code><span class="token-value">3/4</span><span class="token-desc">Portrait images</span></div>
          <div class="token-row"><code class="token-name">--cg-layout-aspect-ratio-ultrawide</code><span class="token-value">21/9</span><span class="token-desc">Ultra wide</span></div>
        </div>
      </div>

      <div class="type-block">
        <h3>Overlays & Focus Shadows</h3>
        <div class="token-examples">
          <div class="token-row"><code class="token-name">--cg-overlay-white-subtle</code><span class="token-value">rgba(255,255,255,0.04)</span><span class="token-desc">Glass/premium effects</span></div>
          <div class="token-row"><code class="token-name">--cg-overlay-white-medium</code><span class="token-value">rgba(255,255,255,0.12)</span><span class="token-desc">Frosted glass</span></div>
          <div class="token-row"><code class="token-name">--cg-shadow-focus-error</code><span class="token-value">0 0 0 3px rgba(239,68,68,0.2)</span><span class="token-desc">Error input ring</span></div>
          <div class="token-row"><code class="token-name">--cg-shadow-focus-success</code><span class="token-value">0 0 0 3px rgba(34,197,94,0.2)</span><span class="token-desc">Success input ring</span></div>
          <div class="token-row"><code class="token-name">--cg-shadow-focus-primary</code><span class="token-value">0 0 0 3px rgba(223,255,97,0.2)</span><span class="token-desc">Primary focus ring</span></div>
        </div>
      </div>

      <div class="type-block">
        <h3>Elevation Shadows</h3>
        <div class="shadow-demos">
          <div class="shadow-card" style="box-shadow: var(--cg-shadow-elevation-xs, 0 1px 2px rgba(0,0,0,0.3));"><span>XS</span></div>
          <div class="shadow-card" style="box-shadow: var(--cg-shadow-elevation-sm, 0 1px 3px rgba(0,0,0,0.3));"><span>SM</span></div>
          <div class="shadow-card" style="box-shadow: var(--cg-shadow-elevation-md, 0 4px 6px rgba(0,0,0,0.3));"><span>MD</span></div>
          <div class="shadow-card" style="box-shadow: var(--cg-shadow-elevation-lg, 0 10px 15px rgba(0,0,0,0.3));"><span>LG</span></div>
          <div class="shadow-card" style="box-shadow: var(--cg-shadow-elevation-xl, 0 20px 25px rgba(0,0,0,0.3));"><span>XL</span></div>
        </div>
      </div>

      <div class="type-block">
        <h3>Large Spacing</h3>
        <div class="token-examples">
          <div class="token-row"><code class="token-name">--cg-spacing-128</code><span class="token-value">128px</span><span class="token-desc">Page section gaps</span></div>
          <div class="token-row"><code class="token-name">--cg-spacing-160</code><span class="token-value">160px</span><span class="token-desc">Large section spacing</span></div>
          <div class="token-row"><code class="token-name">--cg-spacing-192</code><span class="token-value">192px</span><span class="token-desc">Hero padding</span></div>
          <div class="token-row"><code class="token-name">--cg-spacing-256</code><span class="token-value">256px</span><span class="token-desc">Full section spacing</span></div>
        </div>
      </div>
    </section>

    <!-- Usage -->
    <section class="section">
      <h2 id="usage">Usage Example</h2>
      <pre><code>{`.my-card {
  background: var(--cg-color-surface-card-background-default);
  border: 1px solid var(--cg-color-surface-card-border);
  border-radius: var(--cg-component-card-radius);
  padding: var(--cg-spacing-24);
  box-shadow: var(--cg-elevation-1);
  transition: box-shadow var(--cg-motion-duration-normal) var(--cg-motion-easing-default);
}

.my-card:hover {
  box-shadow: var(--cg-elevation-2);
}

.confidence-badge {
  background: var(--cg-ai-confidence-high-background);
  color: var(--cg-ai-confidence-high-color);
  font: var(--cg-font-size-xs) var(--cg-font-family-mono);
}`}</code></pre>
    </section>

    <!-- Naming Convention -->
    <section class="section">
      <h2 id="naming">Naming Convention</h2>
      <pre><code>--cg-[category]-[subcategory]-[property]-[variant]-[state]

Examples:
  --cg-color-action-primary-background-default
  --cg-color-status-success-text
  --cg-typography-heading-h1-fontSize
  --cg-component-button-height-md
  --cg-motion-duration-normal
  --cg-ai-confidence-high-color</code></pre>
    </section>

    <!-- Enforcement / Lint Rules -->
    <section class="section">
      <h2 id="enforcement">Enforcement</h2>
      <p style="margin-bottom: 1rem; color: var(--text-2);">
        The <code>@cognivo/eslint-plugin</code> package ships lint rules that enforce the token system.
        All rules run at <code>error</code> level after v0.4 — CI fails on any raw hex, rgba, fake token,
        or fallback in component CSS.
      </p>

      <h3>Install</h3>
      <pre><code>pnpm add -D @cognivo/eslint-plugin</code></pre>

      <h3>Rules</h3>
      <div class="table-wrap">
        <table class="ref-table">
          <thead><tr><th>Rule</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>no-raw-hex</code></td><td>Reject raw hex values (<code>#fff</code>) in component CSS — use semantic tokens.</td></tr>
            <tr><td><code>no-raw-rgba</code></td><td>Reject raw <code>rgba()</code> / <code>rgb()</code> literals — use surface and overlay tokens.</td></tr>
            <tr><td><code>no-transition-all</code></td><td>Reject <code>transition: all</code> — always specify an explicit property list.</td></tr>
            <tr><td><code>no-fake-tokens</code></td><td>Reject references to tokens that do not exist in <code>@cognivo/tokens</code>.</td></tr>
            <tr><td><code>no-token-fallbacks</code></td><td>Reject <code>var(--cg-x, fallback)</code> — tokens are guaranteed to resolve.</td></tr>
            <tr><td><code>cg-token-prefix</code></td><td>All design tokens authored by Cognivo must use the <code>--cg-</code> prefix.</td></tr>
          </tbody>
        </table>
      </div>

