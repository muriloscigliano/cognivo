---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Dynamic Interfaces">
  <p class="bc"><a href="/">Home</a> <span>/</span> Dynamic Interfaces</p>

  <h1>Dynamic Software Interfaces — the full loop</h1>
  <p class="desc">
    Describe your interface. The request becomes a flat <strong>template with
    data bindings</strong> (not inlined data), it's governed before render
    (fabricated data and undeclared fields are rejected), then rendered against
    live data by a keyed reconciler — <strong>generated once, re-rendered live
    with no model in the data path, no flicker.</strong> Change the data below
    and the same generated interface morphs in place.
    <em>(This demo uses a deterministic mock generator so it runs with no API
    key; the real model swaps in behind the same interface.)</em>
  </p>

  <div class="di-prompt">
    <input id="di-intent" class="di-input" placeholder="e.g. show my inbox as a checklist" value="show my inbox as a list" />
    <cg-button id="di-go" variant="primary" size="sm">Generate</cg-button>
  </div>
  <div class="di-chips">
    <span class="di-label">Try:</span>
    <button class="di-chip" data-intent="show my inbox as a list">list</button>
    <button class="di-chip" data-intent="make it a checklist">checklist</button>
    <button class="di-chip" data-intent="only show overdue">overdue (middleware)</button>
    <button class="di-chip" data-intent="show as a board by priority">board by priority (middleware)</button>
    <button class="di-chip di-bad" data-intent="show everyone's password">⚠ fabricated data</button>
  </div>

  <div class="di-row">
    <span class="di-label">Live data:</span>
    <cg-button size="sm" variant="ghost" data-act="add">+ new message</cg-button>
    <cg-button size="sm" variant="ghost" data-act="reset">reset</cg-button>
    <span class="di-sep2"></span>
    <cg-button id="di-undo" size="sm" variant="ghost">↶ undo shape</cg-button>
  </div>

  <div id="di-stage" class="di-stage"></div>
  <p id="di-note" class="di-note"></p>

  <script>
    import '@cognivo/components';
    import { MockPipelineTemplateLLM } from '../../../specs/dynamic-interfaces/engine/pipeline-mock.ts';
    import { generateWithPipeline } from '../../../specs/dynamic-interfaces/engine/pipeline-generate.ts';
    import { resolvePipeline } from '../../../specs/dynamic-interfaces/engine/pipeline.ts';
    import { resolveTemplate } from '../../../specs/dynamic-interfaces/engine/template-resolver.ts';
    import { semanticFit } from '../../../specs/dynamic-interfaces/engine/semantic-fit.ts';
    import { measure, playFlip } from '../../../specs/dynamic-interfaces/engine/flip.ts';
    import { TemplateStore, createMemoryTemplateBackend } from '../../../specs/dynamic-interfaces/engine/template-store.ts';
    import { createReconciler } from '../../../specs/dynamic-interfaces/engine/reconcile.ts';
    import { createDomDoc, mountInto } from '../../../specs/dynamic-interfaces/engine/dom-adapter.ts';
    import { realRegistry } from '../../../specs/dynamic-interfaces/engine/real-adapter.ts';

    // dueDate spread around "now" so "overdue" filtering is meaningful live.
    const SEED = [
      { subject: 'Q4 budget sign-off', from: 'Dana (CFO)', priority: 'urgent', unread: true, dueDate: '2020-01-01' },
      { subject: 'Design review notes', from: 'Priya', priority: 'high', unread: true, dueDate: '2020-06-01' },
      { subject: 'Sprint retro action items', from: 'Alex', priority: 'high', unread: false, dueDate: '2099-01-01' },
      { subject: 'Lunch?', from: 'Sam', priority: 'low', unread: false, dueDate: '2099-02-01' },
    ];
    let items = structuredClone(SEED);
    const env = () => ({
      schemaId: 'inbox.message.v1',
      fields: [
        { key: 'subject', type: 'text', label: 'Subject' },
        { key: 'from', type: 'text', label: 'From' },
        { key: 'priority', type: 'enum', label: 'Priority', enumValues: ['low', 'normal', 'high', 'urgent'] },
        { key: 'unread', type: 'bool', label: 'Unread' },
        { key: 'dueDate', type: 'date', label: 'Due' },
        { key: 'items', type: 'text', label: 'Items' },
      ],
      items,
    });

    // The vendor's data-layer contract (M0/D0): which ops the agent may run.
    const dataManifest = {
      schemaId: 'inbox.message.v1',
      grants: [
        { field: 'priority', ops: ['group', 'filter'], filterOperators: ['eq', 'in'] },
        { field: 'dueDate', ops: ['filter', 'sort', 'derive'], filterOperators: ['lt', 'gte', 'isEmpty'], deriveFns: ['isOverdue', 'dateBucket'] },
        { field: 'overdue', ops: ['filter'], filterOperators: ['eq'] },
        { field: 'unread', ops: ['filter', 'group'], filterOperators: ['eq'] },
      ],
      policy: { maxRows: 500, maxOps: 8, maxGroups: 50 },
    };

    const stage = document.getElementById('di-stage');
    const note = document.getElementById('di-note');
    const intentInput = document.getElementById('di-intent');

    const client = new MockPipelineTemplateLLM();
    const deps = { client, registry: realRegistry, manifest: dataManifest, now: new Date() };
    const reconciler = createReconciler(realRegistry, createDomDoc(), mountInto(stage));

    // Remember the last pipeline so data changes re-derive consistently.
    let currentPipeline = null;

    // The currently-generated template. Data changes re-resolve THIS — no regen.
    let currentTemplate = null;
    // W2: per-user versioned template corpus (the moat) — in-memory for the demo.
    const store = new TemplateStore({ backend: createMemoryTemplateBackend() });
    const USER = 'demo', TID = 'inbox-main';

    function humanReason(r) {
      if (r.code === 'undeclared-field') return 'it tried to show data that isn’t in your inbox';
      if (r.code === 'unknown-component') return `“${r.where}” isn’t a real component`;
      if (r.code === 'parse') return 'the generated layout was malformed';
      return r.message;
    }

    async function generate(intent) {
      // FRONTIER path: generate {pipeline?, template}, govern both, bind derived data.
      const result = await generateWithPipeline(intent, env(), deps, { system: '', user: intent });
      if (!result.ok) {
        note.textContent = `I couldn’t do that safely — ${humanReason(result.rejections[0])}. Showing the previous view.`;
        note.className = 'di-note err';
        return;
      }
      currentTemplate = result.output.template;
      currentPipeline = result.output.pipeline ?? null;
      const first = measure(keyedEls());
      reconciler.render(result.resolved);
      playFlip(first, keyedEls());
      // W2: persist this generated template as a new version (the corpus/moat).
      await store.save({ userId: USER, templateId: TID, intent, template: result.output.template });
      // S3: surface a metacognitive fit note if the shape fits the data poorly.
      const fit = semanticFit(result.output.template, env(), intent);
      const warn = fit.find((n) => n.severity === 'warn') || fit[0];
      const fitMsg = warn ? ` · note: ${warn.message}${warn.suggestion ? ` (try: ${warn.suggestion})` : ''}` : '';
      const mw = currentPipeline ? ` · middleware: ${currentPipeline.ops.map((o) => o.kind).join('→')}` : '';
      note.textContent = `Generated (${Object.keys(result.output.template.nodes).length} nodes) · ${result.boundEnvelope.items.length} rows${mw} · governed ✓ · saved${fitMsg}`;
      note.className = warn && warn.severity === 'warn' ? 'di-note warn' : 'di-note ok';
    }

    function keyedEls() {
      const m = new Map();
      stage.querySelectorAll('[data-flip-id]').forEach((el) => m.set(el.getAttribute('data-flip-id'), el));
      return m;
    }

    // Data change: re-run the SAME pipeline (if any) + re-resolve the SAME
    // template — NO regeneration, NO model call. The middleware re-derives live.
    function reRenderData(reason) {
      if (!currentTemplate) return;
      let boundEnv = env();
      if (currentPipeline) {
        const run = resolvePipeline(currentPipeline, env(), dataManifest, { now: new Date() });
        if (!run.output) { note.textContent = `Rejected — ${run.rejections[0]?.message}`; note.className = 'di-note err'; return; }
        boundEnv = run.output;
      }
      const { root, rejections } = resolveTemplate(currentTemplate, boundEnv);
      if (!root) { note.textContent = `Rejected — ${rejections[0]?.message}`; note.className = 'di-note err'; return; }
      const first = measure(keyedEls());          // FLIP: First positions
      const stats = reconciler.render(root);
      playFlip(first, keyedEls());                // Invert + Play → morph in place
      note.textContent = `${reason} · re-resolved ${items.length} items · reconcile {created:${stats.created} updated:${stats.updated} reused:${stats.reused} removed:${stats.removed}} · NO model call`;
      note.className = 'di-note ok';
    }

    document.getElementById('di-go').addEventListener('click', () => generate(intentInput.value));
    intentInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') generate(intentInput.value); });
    document.querySelectorAll('[data-intent]').forEach((c) =>
      c.addEventListener('click', () => { intentInput.value = c.getAttribute('data-intent'); generate(intentInput.value); }),
    );
    document.querySelectorAll('[data-act]').forEach((b) =>
      b.addEventListener('click', () => {
        const act = b.getAttribute('data-act');
        if (act === 'add') items = [{ subject: `New task ${items.length + 1}`, from: 'You', priority: 'normal', unread: true }, ...items];
        else if (act === 'reset') items = structuredClone(SEED);
        reRenderData(`Data changed (${act})`);
      }),
    );

    // W2: first-class undo — restore the previous shape, morph back (no hard cut).
    document.getElementById('di-undo').addEventListener('click', async () => {
      const restored = await store.undo(USER, TID);
      if (!restored) { note.textContent = 'Nothing to undo yet.'; note.className = 'di-note'; return; }
      currentTemplate = restored.template;
      const { root } = resolveTemplate(currentTemplate, env());
      if (!root) return;
      const first = measure(keyedEls());
      reconciler.render(root);
      playFlip(first, keyedEls());
      note.textContent = `Undone → restored "${restored.intent}" (now v${restored.version}, append-only) · morphed back`;
      note.className = 'di-note ok';
    });

    generate(intentInput.value);
  </script>

  <style>
    .di-prompt { display: flex; gap: var(--cg-spacing-8); margin: var(--cg-spacing-16) 0 var(--cg-spacing-8); }
    .di-input {
      flex: 1; padding: var(--cg-spacing-8) var(--cg-spacing-12); font-size: var(--cg-font-size-md);
      border-radius: var(--cg-border-radius-150); background: var(--cg-color-surface-inset-background);
      color: var(--cg-color-surface-base-text); border: var(--cg-border-width-100) solid var(--cg-color-surface-base-border);
    }
    .di-chips, .di-row { display: flex; align-items: center; gap: var(--cg-spacing-8); flex-wrap: wrap; margin: var(--cg-spacing-8) 0; }
    .di-sep2 { width: var(--cg-border-width-100); height: 20px; background: var(--cg-color-surface-base-border); margin: 0 var(--cg-spacing-4); }
    .di-label { color: var(--cg-color-surface-inset-text); font-size: var(--cg-font-size-sm); }
    .di-chip {
      font-size: var(--cg-font-size-sm); padding: var(--cg-spacing-4) var(--cg-spacing-12);
      border-radius: var(--cg-border-radius-full); cursor: pointer;
      background: var(--cg-color-surface-inset-background); color: var(--cg-color-surface-base-text);
      border: var(--cg-border-width-100) solid var(--cg-color-surface-base-border);
    }
    .di-chip.di-bad { color: var(--cg-color-status-error-text-default); }
    .di-stage {
      min-height: 220px; padding: var(--cg-spacing-24); border-radius: var(--cg-border-radius-200); margin-top: var(--cg-spacing-12);
      background: var(--cg-color-surface-container-background); border: var(--cg-border-width-100) solid var(--cg-color-surface-base-border);
    }
    .di-note { font-size: var(--cg-font-size-sm); margin-top: var(--cg-spacing-12); font-family: var(--cg-font-family-mono); }
    .di-note.ok { color: var(--cg-color-status-success-text-default); }
    .di-note.warn { color: var(--cg-color-status-warning-text-default); }
    .di-note.err { color: var(--cg-color-status-error-text-default); }
  </style>
</DocsLayout>
