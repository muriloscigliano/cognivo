---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Dynamic Interfaces">
  <p class="bc"><a href="/">Home</a> <span>/</span> Dynamic Interfaces</p>

  <h1>Dynamic Software Interfaces</h1>
  <p class="desc">
    The real loop, end to end: a component-DSL tree is parsed by the
    <strong>real</strong> gen-ui parser, run through the governance engine
    (unknown components, token violations, and fabricated-data provenance all
    block render), and only then rendered with real <code>cg-*</code>
    components. A rejected tree never renders — you see the previous good
    surface and a plain-language reason.
  </p>

  <div class="di-shapes">
    <span class="di-label">Try a shape:</span>
    <cg-button size="sm" variant="outline" data-shape="list">List</cg-button>
    <cg-button size="sm" variant="outline" data-shape="tasks">Task list</cg-button>
    <cg-button size="sm" variant="outline" data-shape="summary">Summary</cg-button>
    <cg-button size="sm" variant="ghost" data-shape="bad-unknown">⚠ unknown component</cg-button>
    <cg-button size="sm" variant="ghost" data-shape="bad-data">⚠ fabricated data</cg-button>
  </div>

  <div id="di-stage" class="di-stage"></div>
  <p id="di-note" class="di-note"></p>

  <script>
    import '@cognivo/components';
    import {
      parseRealDsl,
      realRegistry,
      realTokenValidator,
      dataProvenanceRejections,
    } from '../../../specs/dynamic-interfaces/engine/real-adapter.ts';
    import { govern } from '../../../specs/dynamic-interfaces/engine/governance.ts';
    import { renderGoverned } from '../../../specs/dynamic-interfaces/engine/render.ts';

    // The shared inbox dataset (provenance firewall checks against this).
    const ENV = {
      schemaId: 'inbox.message.v1',
      fields: [
        { key: 'subject', type: 'text', label: 'Subject' },
        { key: 'priority', type: 'enum', label: 'Priority', enumValues: ['low', 'normal', 'high', 'urgent'] },
      ],
      items: [
        { subject: 'Q4 budget sign-off', priority: 'urgent' },
        { subject: 'Design review notes', priority: 'high' },
        { subject: 'Sprint retro action items', priority: 'high' },
        { subject: 'Lunch?', priority: 'low' },
      ],
    };

    // Each "shape" is real DSL that references only real dataset values.
    const SHAPES = {
      list: [
        'root = Stack([r1, r2, r3, r4], "column", "sm")',
        'r1 = Stack([Badge("urgent","danger"), TextContent("Q4 budget sign-off","medium")], "row", "sm")',
        'r2 = Stack([Badge("high","warning"), TextContent("Design review notes","medium")], "row", "sm")',
        'r3 = Stack([Badge("high","warning"), TextContent("Sprint retro action items","medium")], "row", "sm")',
        'r4 = Stack([Badge("low","neutral"), TextContent("Lunch?","medium")], "row", "sm")',
      ].join('\n'),
      tasks: [
        'root = Stack([c1, c2, c3, c4], "column", "sm")',
        'c1 = Checkbox("Q4 budget sign-off", false)',
        'c2 = Checkbox("Design review notes", false)',
        'c3 = Checkbox("Sprint retro action items", false)',
        'c4 = Checkbox("Lunch?", false)',
      ].join('\n'),
      summary: [
        'root = Stack([h, m], "column", "lg")',
        'h = TextContent("Inbox summary", "large")',
        'm = Stack([MetricCard("Total","4",""), MetricCard("High+","3",""), MetricCard("Urgent","1","")], "row", "md")',
      ].join('\n'),
      // Deliberately broken, to SHOW governance blocking:
      'bad-unknown': 'root = Stack([TotallyFakeComponent("x")], "column")',
      'bad-data': 'root = Stack([TextContent("Everyone secret password is hunter2","medium")], "column")',
    };

    const deps = { registry: realRegistry, validateTokens: realTokenValidator };
    const stage = document.getElementById('di-stage');
    const note = document.getElementById('di-note');

    function show(shapeKey) {
      const dsl = SHAPES[shapeKey];
      const { uiNode, parseRejections } = parseRealDsl(dsl);

      if (!uiNode) {
        note.textContent = `Couldn’t build that — ${parseRejections[0]?.message ?? 'parse failed'}. Showing the previous view.`;
        note.className = 'di-note err';
        return; // keep the last good surface (coherent: never render broken)
      }

      const g = govern(uiNode, ENV, deps);
      const provenance = dataProvenanceRejections(uiNode, ENV);
      const rejections = [...g.rejections, ...provenance];

      if (rejections.length > 0) {
        // Legible refusal in plain language; the previous surface stays.
        note.textContent = `I couldn’t do that safely — ${humanReason(rejections[0])}. Showing the previous view.`;
        note.className = 'di-note err';
        return;
      }

      renderGoverned(uiNode, stage, realRegistry);
      note.textContent = `Reshaped to “${shapeKey}” · governed ✓`;
      note.className = 'di-note ok';
    }

    function humanReason(r) {
      switch (r.code) {
        case 'unknown-component': return `“${r.where}” isn’t a real component`;
        case 'undeclared-field': return `it tried to show data that isn’t in your inbox`;
        case 'token-violation': return `it used an off-brand style`;
        case 'a11y': return `“${r.where}” wouldn’t be accessible`;
        default: return r.message;
      }
    }

    document.querySelectorAll('[data-shape]').forEach((b) =>
      b.addEventListener('click', () => show(b.getAttribute('data-shape'))),
    );

    // Boot with a real, governed surface — pixels on screen immediately.
    show('list');
  </script>

  <style>
    .di-shapes { display: flex; align-items: center; gap: var(--cg-spacing-8); flex-wrap: wrap; margin: var(--cg-spacing-16) 0; }
    .di-label { color: var(--cg-color-surface-inset-text); font-size: var(--cg-font-size-sm); }
    .di-stage {
      min-height: 240px; padding: var(--cg-spacing-24); border-radius: var(--cg-border-radius-200);
      background: var(--cg-color-surface-container-background);
      border: var(--cg-border-width-100) solid var(--cg-color-surface-base-border);
    }
    .di-note { font-size: var(--cg-font-size-sm); margin-top: var(--cg-spacing-12); }
    .di-note.ok { color: var(--cg-color-status-success-text-default); }
    .di-note.err { color: var(--cg-color-status-error-text-default); }
  </style>
</DocsLayout>
