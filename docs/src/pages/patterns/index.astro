---
import DocsLayout from '../../layouts/DocsLayout.astro';

const patterns = [
  {
    name: 'Guardrails',
    module: 'GuardedClient',
    description: 'Validate AI inputs and outputs against configurable rules. Prevent prompt injection, enforce length limits, check confidence ranges, and block PII.',
    example: `import { GuardedClient, maxLengthRule, noPromptInjectionRule, noPiiRule } from '@cognivo/core';

const client = new GuardedClient(baseClient, {
  rules: [maxLengthRule(500), noPromptInjectionRule, noPiiRule],
});`,
  },
  {
    name: 'Resilience (Fallback)',
    module: 'FallbackClient',
    description: 'Automatically fall back to alternate AI providers when the primary fails. Configure multiple providers in priority order.',
    example: `import { FallbackClient } from '@cognivo/core';

const client = new FallbackClient({
  clients: [openAiClient, anthropicClient],
  maxRetries: 2,
});`,
  },
  {
    name: 'Caching',
    module: 'CachedClient',
    description: 'LRU cache for AI responses. Avoid redundant API calls for identical requests.',
    example: `import { CachedClient, InMemoryLruCache } from '@cognivo/core';

const client = new CachedClient(baseClient, {
  cache: new InMemoryLruCache({ maxSize: 100 }),
});`,
  },
  {
    name: 'Semantic Caching',
    module: 'SemanticCachedClient',
    description: 'Cache based on semantic similarity rather than exact match. Uses embeddings to find similar previous queries.',
    example: `import { SemanticCachedClient, SemanticCacheStore } from '@cognivo/core';

const client = new SemanticCachedClient(baseClient, {
  store: new SemanticCacheStore({ threshold: 0.9 }),
});`,
  },
  {
    name: 'Model Routing',
    module: 'ModelRouterClient',
    description: 'Route requests to different AI models based on intent, complexity, or custom logic. Optimize cost and quality.',
    example: `import { ModelRouterClient } from '@cognivo/core';

const client = new ModelRouterClient({
  routes: [
    { match: { intent: AiIntent.Summarize }, client: fastClient },
    { match: { intent: AiIntent.Forecast }, client: advancedClient },
  ],
  default: baseClient,
});`,
  },
  {
    name: 'Conversation',
    module: 'ConversationalClient',
    description: 'Manage multi-turn conversations with automatic history tracking and context window management.',
    example: `import { ConversationalClient } from '@cognivo/core';

const client = new ConversationalClient(baseClient, {
  maxTurns: 20,
  systemPrompt: 'You are a data analyst.',
});`,
  },
  {
    name: 'Circuit Breaker',
    module: 'CircuitBreakerClient',
    description: 'Stop calling a failing provider after repeated errors. Auto-recover after a cooldown period.',
    example: `import { CircuitBreakerClient } from '@cognivo/core';

const client = new CircuitBreakerClient(baseClient, {
  failureThreshold: 5,
  cooldownMs: 30_000,
});`,
  },
  {
    name: 'Self-Refine',
    module: 'SelfRefineClient',
    description: 'Iteratively improve AI responses by feeding the output back as input. Useful for complex analysis.',
    example: `import { SelfRefineClient } from '@cognivo/core';

const client = new SelfRefineClient(baseClient, {
  maxIterations: 3,
  judge: (result) => result.confidence > 0.9,
});`,
  },
  {
    name: 'Extended Thinking',
    module: 'ExtendedThinkingClient',
    description: 'Chain-of-thought reasoning with structured steps. The AI shows its work before producing a final answer.',
    example: `import { ExtendedThinkingClient } from '@cognivo/core';

const client = new ExtendedThinkingClient(baseClient, {
  steps: ['analyze', 'hypothesize', 'verify', 'conclude'],
});`,
  },
  {
    name: 'Prompt Optimization',
    module: 'PromptOptimizer',
    description: 'Automatically improve prompts based on evaluation metrics. A/B test different prompt strategies.',
    example: `import { PromptOptimizer, PromptEvaluator } from '@cognivo/core';

const optimizer = new PromptOptimizer({
  evaluator: new PromptEvaluator({ metrics: ['relevance', 'coherence'] }),
  variants: [promptA, promptB],
});`,
  },
  {
    name: 'Agent Coordination',
    module: 'AgentCoordinator',
    description: 'Orchestrate multiple AI agents with a planner. Each agent has a role and the coordinator manages the workflow.',
    example: `import { AgentCoordinator } from '@cognivo/core';

const coordinator = new AgentCoordinator({
  agents: { analyst: analyticsClient, writer: contentClient },
  planner: plannerClient,
});
const result = await coordinator.execute('Analyze Q4 sales and write a report');`,
  },
  {
    name: 'Observability',
    module: 'ObservableClient',
    description: 'Trace AI requests with spans, timing, and metadata. Integrates with any tracing backend via the AiTracer interface.',
    example: `import { ObservableClient, InMemoryTracer } from '@cognivo/core';

const tracer = new InMemoryTracer();
const client = new ObservableClient(baseClient, { tracer });

await client.run(context);
console.log(tracer.spans); // [{ name, duration, metadata, ... }]`,
  },
];
---

<DocsLayout title="AI Patterns">
  <h1>AI Integration Patterns</h1>
  <p class="subtitle">
    12 production-ready patterns for robust AI integration. All patterns implement <code>AiClient</code>
    and compose via the decorator pattern.
  </p>
  <p class="install">
    <strong>Install:</strong> <code>pnpm add @cognivo/core</code> — all patterns included.
  </p>

  {patterns.map((pattern, i) => (
    <section class="pattern" id={`p${i}`}>
      <div class="pattern-header">
        <span class="pattern-num">{String(i + 1).padStart(2, '0')}</span>
        <h2>{pattern.name}</h2>
        <code class="pattern-mod">{pattern.module}</code>
      </div>
      <p>{pattern.description}</p>
      <pre><code>{pattern.example}</code></pre>
    </section>
  ))}

  <cg-callout variant="info" title="Composing Patterns">
    <span>All patterns implement <code>AiClient</code>, so you can stack them:
    <code>ObservableClient(GuardedClient(CachedClient(OpenAiClient)))</code>.
    See the <a href="/core" style="color: var(--accent);">Core API</a> page for a full example.</span>
  </cg-callout>

  <style>
    h1 { font-size: 2rem; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.03em; }
    .subtitle { color: var(--fg-2); margin-bottom: 12px; line-height: 1.7; }
    .install { margin-bottom: 32px; font-size: 14px; color: var(--fg-3); }

    .pattern {
      margin-bottom: 20px;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }
    .pattern:hover { border-color: var(--border-hover); }
    .pattern-header {
      display: flex; align-items: baseline; gap: 10px;
      margin-bottom: 8px;
    }
    .pattern-num {
      font: 700 13px/1 var(--font-mono);
      color: var(--accent);
    }
    .pattern-header h2 {
      font-size: 18px; font-weight: 700;
      margin: 0; padding: 0; border: none;
    }
    .pattern-header h2::before { display: none; }
    .pattern-mod {
      font-size: 12px;
      color: var(--accent);
      opacity: 0.7;
    }
    .pattern p {
      color: var(--fg-2); margin-bottom: 16px; line-height: 1.7;
    }
    .pattern pre { margin: 0; }
  </style>
</DocsLayout>
