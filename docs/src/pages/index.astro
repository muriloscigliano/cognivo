---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { value: '143', label: 'Components', detail: '54 foundation + 89 AI-native' },
  { value: '1,800+', label: 'Design Tokens', detail: '3-tier system with palette generator' },
  { value: '1,107', label: 'Tests', detail: '1,062 passing across all packages' },
  { value: '184', label: 'Cognitive Biases', detail: 'With design implications & guidance' },
];

const packages = [
  { name: '@cognivo/components', desc: '143 Lit web components with Shadow DOM', icon: '◆' },
  { name: '@cognivo/tokens', desc: '1,800+ design tokens, 3-tier system', icon: '◈' },
  { name: '@cognivo/core', desc: 'Framework-agnostic AI integration', icon: '⬡' },
  { name: '@cognivo/gen-ui', desc: 'Streaming parser & component registry', icon: '▣' },
  { name: '@cognivo/adapter-react', desc: 'React wrappers with TypeScript props', icon: '◎' },
  { name: '@cognivo/adapter-vue', desc: 'Vue wrappers with TypeScript props', icon: '◉' },
  { name: '@cognivo/design-advisor', desc: '184 cognitive bias cards & registry', icon: '◇' },
  { name: '@cognivo/adapter-openai', desc: 'OpenAI client with structured outputs', icon: '⬢' },
];

const features = [
  { title: 'AI-Native Components', desc: 'Chat, streaming text, thinking indicators, command palettes, confidence sliders — built for AI-first interfaces.', accent: true },
  { title: 'Design Token System', desc: '3-tier token architecture: core primitives, semantic layer, component-specific. Full dark mode. Zero magic numbers.', accent: false },
  { title: 'Cognitive Psychology', desc: '184 documented cognitive biases with design implications. Know which biases your UI triggers and why.', accent: false },
  { title: 'Framework Agnostic', desc: 'Web Components work everywhere. First-class React and Vue adapters included. No lock-in.', accent: false },
  { title: 'Accessibility First', desc: 'ARIA roles, keyboard navigation, focus management, reduced-motion support, 44px touch targets. All built-in.', accent: false },
  { title: 'Streaming Generative UI', desc: 'Parse and render AI model outputs in real-time. Component registry resolves streaming JSON to live UI.', accent: true },
];
---

<BaseLayout title="Home">
  <section style="position: relative; overflow: hidden; padding: 6rem 2rem 4rem; text-align: center;">
    <div style="position: absolute; top: -200px; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, rgba(223, 255, 97, 0.06) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: var(--max-width); margin: 0 auto;">
      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; background: var(--accent-muted); border: 1px solid rgba(223, 255, 97, 0.2); border-radius: var(--radius-pill); font-size: 0.8125rem; font-weight: 500; color: var(--accent); margin-bottom: 2rem;">
        <span style="width: 6px; height: 6px; background: var(--accent); border-radius: 50%; animation: pulse 2s infinite;"></span>
        v0.3 — 143 components shipping
      </div>

      <h1 style="font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
        Build AI interfaces<br />
        <span style="background: linear-gradient(135deg, var(--accent), #a3e635); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">that think with users</span>
      </h1>

      <p style="font-size: clamp(1rem, 2vw, 1.25rem); color: var(--text-2); max-width: 640px; margin: 0 auto 2.5rem; line-height: 1.7;">
        AI-native component library with cognitive psychology integration.<br />
        143 Web Components. 1,800+ design tokens. 184 cognitive biases. Works everywhere.
      </p>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 5rem;">
        <a href="/getting-started" style="display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #09090b; padding: 12px 28px; border-radius: var(--radius); font-weight: 600; font-size: 0.9375rem; box-shadow: 0 0 20px rgba(223, 255, 97, 0.15);">
          Get Started <span style="font-size: 1.1em;">→</span>
        </a>
        <a href="/components" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-strong); padding: 12px 28px; border-radius: var(--radius); color: var(--text-1); font-weight: 500; font-size: 0.9375rem;">
          Browse Components
        </a>
        <a href="https://github.com/muriloscigliano/cognivo" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border); padding: 12px 28px; border-radius: var(--radius); color: var(--text-2); font-weight: 500; font-size: 0.9375rem;">
          GitHub
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border-radius: var(--radius); overflow: hidden; max-width: 900px; margin: 0 auto;">
        {stats.map(stat => (
          <div style="background: var(--bg-subtle); padding: 24px 16px; text-align: center;">
            <div style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-1); line-height: 1;">{stat.value}</div>
            <div style="font-size: 0.8125rem; font-weight: 600; color: var(--accent); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.05em;">{stat.label}</div>
            <div style="font-size: 0.75rem; color: var(--text-3); margin-top: 4px;">{stat.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 5rem;">
    <div style="background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
      <div style="display: flex; align-items: center; gap: 8px; padding: 12px 20px; border-bottom: 1px solid var(--border);">
        <span style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444;"></span>
        <span style="width: 12px; height: 12px; border-radius: 50%; background: #eab308;"></span>
        <span style="width: 12px; height: 12px; border-radius: 50%; background: #22c55e;"></span>
        <span style="margin-left: auto; font-size: 0.75rem; color: var(--text-3); font-family: var(--font-mono);">quickstart.html</span>
      </div>
      <pre style="margin: 0; border: none; border-radius: 0; padding: 24px; font-size: 0.875rem; line-height: 1.8;"><code><span style="color: #71717a;">&lt;!-- Import once --&gt;</span>
<span style="color: #71717a;">&lt;script</span> <span style="color: var(--accent);">type</span>=<span style="color: #a3e635;">"module"</span> <span style="color: var(--accent);">src</span>=<span style="color: #a3e635;">"@cognivo/components"</span><span style="color: #71717a;">&gt;&lt;/script&gt;</span>

<span style="color: #71717a;">&lt;!-- Use anywhere --&gt;</span>
<span style="color: #71717a;">&lt;</span><span style="color: var(--accent);">ai-chat</span><span style="color: #71717a;">&gt;&lt;/</span><span style="color: var(--accent);">ai-chat</span><span style="color: #71717a;">&gt;</span>
<span style="color: #71717a;">&lt;</span><span style="color: var(--accent);">cg-button</span> <span style="color: #a3e635;">variant</span>=<span style="color: #a3e635;">"primary"</span><span style="color: #71717a;">&gt;</span>Get Started<span style="color: #71717a;">&lt;/</span><span style="color: var(--accent);">cg-button</span><span style="color: #71717a;">&gt;</span></code></pre>
    </div>
  </section>

  <section style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 5rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em;">Built different</h2>
      <p style="color: var(--text-2); margin-top: 8px; font-size: 1.0625rem;">Not just components — a cognitive design system.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px;">
      {features.map(f => (
        <div style={`background: var(--bg-subtle); border: 1px solid ${f.accent ? 'rgba(223, 255, 97, 0.15)' : 'var(--border)'}; border-radius: var(--radius); padding: 28px;`}>
          <h3 style="font-size: 1.0625rem; font-weight: 600; margin-bottom: 8px;">{f.title}</h3>
          <p style="color: var(--text-2); font-size: 0.9375rem; line-height: 1.6;">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 5rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em;">10 packages, one system</h2>
      <p style="color: var(--text-2); margin-top: 8px; font-size: 1.0625rem;">pnpm workspaces + Turborepo. Install what you need.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
      {packages.map(pkg => (
        <div style="display: flex; align-items: flex-start; gap: 14px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px;">
          <span style="font-size: 1.25rem; color: var(--accent); flex-shrink: 0; margin-top: 2px;">{pkg.icon}</span>
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; color: var(--text-1); margin-bottom: 4px;">{pkg.name}</div>
            <div style="font-size: 0.8125rem; color: var(--text-3); line-height: 1.5;">{pkg.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 6rem; text-align: center;">
    <div style="background: var(--bg-subtle); border: 1px solid rgba(223, 255, 97, 0.1); border-radius: var(--radius); padding: 48px 32px; position: relative; overflow: hidden;">
      <div style="position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(223, 255, 97, 0.04) 0%, transparent 70%); pointer-events: none;"></div>
      <div style="position: relative;">
        <h2 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 12px; letter-spacing: -0.02em;">Ready to build?</h2>
        <p style="color: var(--text-2); margin-bottom: 24px;">Get started in under 2 minutes. Zero config.</p>
        <a href="/getting-started" style="display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #09090b; padding: 12px 28px; border-radius: var(--radius); font-weight: 600; font-size: 0.9375rem;">
          Get Started →
        </a>
        <p style="margin-top: 16px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-3);">
          pnpm add @cognivo/components @cognivo/tokens
        </p>
      </div>
    </div>
  </section>

  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    @media (max-width: 768px) {
      section > div[style*="grid-template-columns: repeat(4"] {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition-duration: 0.01ms !important; }
    }
  </style>
</BaseLayout>
