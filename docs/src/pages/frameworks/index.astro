---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Framework Integration">
  <div class="fw-page">
    <header class="page-header">
      <h1>Framework Integration</h1>
      <p class="subtitle">
        Cognivo components are Web Components — they work in any framework or vanilla HTML.
        First-class React and Vue adapters provide native DX with full TypeScript support.
      </p>
    </header>

    <!-- Vanilla HTML -->
    <section class="section">
      <h2 id="vanilla">Vanilla HTML / Any Framework</h2>
      <p class="section-desc">Import once, use everywhere. No framework adapter needed.</p>
      <pre><code>{`<script type="module">
  import '@cognivo/components';
</script>
<link rel="stylesheet" href="node_modules/@cognivo/tokens/dist/index.css">

<cg-button variant="primary" size="md">Click me</cg-button>
<ai-chat placeholder="Ask anything..."></ai-chat>
<ai-thinking variant="dots" text="Analyzing..."></ai-thinking>`}</code></pre>

      <div class="note">
        Web Components work natively in Angular, Svelte, Astro, SolidJS, and any framework
        that renders to the DOM. No wrappers required.
      </div>
    </section>

    <!-- React -->
    <section class="section">
      <h2 id="react">React</h2>
      <p class="section-desc">Type-safe React wrappers with proper event handling and prop mapping.</p>

      <h3>Installation</h3>
      <pre><code>pnpm add @cognivo/adapter-react @cognivo/components @cognivo/tokens</code></pre>

      <h3>Setup</h3>
      <pre><code>{`// app.tsx or layout.tsx — import tokens CSS once
import '@cognivo/tokens/dist/index.css';`}</code></pre>

      <h3>Usage</h3>
      <pre><code>{`import { CgButton, CgInput, CgCard, AiChat, AiThinking } from '@cognivo/adapter-react';

function Dashboard() {
  const [query, setQuery] = useState('');

  return (
    <div>
      <CgCard variant="elevated">
        <CgInput
          label="Search"
          value={query}
          onCgInput={(e) => setQuery(e.detail.value)}
        />
        <CgButton variant="primary" onCgClick={() => search(query)}>
          Search
        </CgButton>
      </CgCard>

      <AiThinking variant="dots" text="Processing..." />
      <AiChat placeholder="Ask a question..." />
    </div>
  );
}`}</code></pre>

      <h3>Event Handling</h3>
      <p style="color: var(--text-2); margin-bottom: 1rem; font-size: 0.9rem;">
        React wrappers map Web Component custom events to React-style callbacks.
        The event prefix is <code>on</code> + PascalCase event name.
      </p>
      <div class="table-wrap">
        <table class="ref-table">
          <thead><tr><th>Web Component Event</th><th>React Prop</th><th>Detail Type</th></tr></thead>
          <tbody>
            <tr><td><code>cg-click</code></td><td><code>onCgClick</code></td><td><code>MouseEvent</code></td></tr>
            <tr><td><code>cg-input</code></td><td><code>onCgInput</code></td><td><code>{`{ value: string }`}</code></td></tr>
            <tr><td><code>cg-change</code></td><td><code>onCgChange</code></td><td><code>{`{ value: string, error?: boolean }`}</code></td></tr>
            <tr><td><code>ai-message</code></td><td><code>onAiMessage</code></td><td><code>{`{ text: string, role: string }`}</code></td></tr>
          </tbody>
        </table>
      </div>

      <h3>TypeScript</h3>
      <pre><code>{`// All props and events are fully typed
import type { CgButton, CgInput, AiChat } from '@cognivo/adapter-react';

// Example: typed event handler
const handleInput = (e: CustomEvent<{ value: string }>) => {
  console.log(e.detail.value);
};`}</code></pre>
    </section>

    <!-- Vue -->
    <section class="section">
      <h2 id="vue">Vue</h2>
      <p class="section-desc">Vue 3 wrappers with v-model support and typed props.</p>

      <h3>Installation</h3>
      <pre><code>pnpm add @cognivo/adapter-vue @cognivo/components @cognivo/tokens</code></pre>

      <h3>Setup</h3>
      <pre><code>{`// main.ts
import '@cognivo/tokens/dist/index.css';`}</code></pre>

      <h3>Usage</h3>
      <pre><code>{`<script setup lang="ts">
import { CgButton, CgInput, CgCard, AiChat } from '@cognivo/adapter-vue';
import { ref } from 'vue';

const query = ref('');
</script>

<template>
  <CgCard variant="elevated">
    <CgInput
      label="Search"
      :value="query"
      @cg-input="query = $event.detail.value"
    />
    <CgButton variant="primary" @cg-click="search(query)">
      Search
    </CgButton>
  </CgCard>

  <AiChat placeholder="Ask a question..." />
</template>`}</code></pre>

      <h3>Event Handling</h3>
      <p style="color: var(--text-2); margin-bottom: 0.5rem; font-size: 0.9rem;">
        Vue wrappers emit the same custom events as the Web Components. Use <code>@event-name</code> syntax.
      </p>
    </section>

    <!-- Svelte / Angular / Others -->
    <section class="section">
      <h2 id="svelte">Svelte, Angular, SolidJS</h2>
      <p class="section-desc">No adapter needed — use Web Components directly.</p>

      <h3>Svelte</h3>
      <pre><code>{`<script>
  import '@cognivo/components';
  import '@cognivo/tokens/dist/index.css';
</script>

<cg-button variant="primary" on:cg-click={handleClick}>
  Click me
</cg-button>`}</code></pre>

      <h3>Angular</h3>
      <pre><code>{`// app.module.ts — enable custom elements
import { CUSTOM_ELEMENTS_SCHEMA } from '@angular/core';

@NgModule({
  schemas: [CUSTOM_ELEMENTS_SCHEMA],
})
export class AppModule {}

// Import in styles.css
@import '@cognivo/tokens';

// Use in templates
// <cg-button variant="primary">Click</cg-button>`}</code></pre>
    </section>

    <!-- Dark Mode -->
    <section class="section">
      <h2>Dark Mode (All Frameworks)</h2>
      <pre><code>{`// Set on document root — works in all frameworks
document.documentElement.setAttribute('data-theme', 'dark');

// React example
function ThemeToggle() {
  const [dark, setDark] = useState(true);
  useEffect(() => {
    document.documentElement.setAttribute(
      'data-theme', dark ? 'dark' : 'light'
    );
  }, [dark]);
  return <CgSwitch checked={dark} onCgChange={() => setDark(!dark)} />;
}`}</code></pre>
    </section>

    <!-- Tree Shaking -->
    <section class="section">
      <h2>Tree Shaking</h2>
      <p style="color: var(--text-2); margin-bottom: 1rem; font-size: 0.9rem;">
        Import individual components to reduce bundle size:
      </p>
      <pre><code>{`// Full library (registers all 143 components)
import '@cognivo/components';

// Individual imports (tree-shakeable)
import { CgButton } from '@cognivo/components';
import { AiChat } from '@cognivo/components';`}</code></pre>
    </section>
  </div>

  <style>
    .fw-page { }

    .page-header h1 {
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 0.5rem;
    }
    .subtitle {
      color: var(--text-2);
      font-size: 1.0625rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    .section { margin-bottom: 3rem; }
    .section h2 {
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .section h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }
    .section-desc {
      color: var(--text-2);
      font-size: 0.9375rem;
      margin-bottom: 1rem;
    }

    .note {
      padding: 12px 16px;
      background: rgba(223, 255, 97, 0.04);
      border: 1px solid rgba(223, 255, 97, 0.12);
      border-radius: 8px;
      font-size: 0.875rem;
      color: var(--text-2);
      margin-top: 1rem;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 1rem;
    }
    .ref-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
    }
    .ref-table th {
      text-align: left;
      padding: 10px 16px;
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    .ref-table td {
      padding: 10px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      color: var(--text-2);
    }
    .ref-table tr:last-child td { border-bottom: none; }
  </style>
</DocsLayout>
