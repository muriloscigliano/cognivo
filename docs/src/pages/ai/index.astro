---
import DocsLayout from '../../layouts/DocsLayout.astro';
import StatsRow from '../../components/StatsRow.astro';
import { registry, categories } from '../../data/components';

// AI components only. Foundation components live at /components.
const isAiCategory = (id: string) => id.startsWith('ai-');

const byLabel = (a: { label: string }, b: { label: string }) =>
  a.label.localeCompare(b.label);
const byName = (a: { name: string }, b: { name: string }) =>
  a.name.localeCompare(b.name);

const aiCategories = [...categories]
  .filter(c => isAiCategory(c.id))
  .sort(byLabel);

const grouped = aiCategories
  .map(cat => ({
    ...cat,
    items: registry.filter(c => c.category === cat.id).sort(byName),
  }))
  .filter(g => g.items.length > 0);

const aiCount = grouped.reduce((n, g) => n + g.items.length, 0);
const foundationCount = registry.length - aiCount;
---

<DocsLayout title="AI Components">
  <h1>AI Components</h1>
  <p class="sub">{aiCount} AI-native web components built for LLM interfaces — chat, streaming, reasoning, agents, insights, and more.</p>

  <StatsRow stats={[
    { value: aiCount, label: 'AI Components' },
    { value: grouped.length, label: 'Categories' },
    { value: foundationCount, label: '← Foundation', href: '/components' },
  ]} />

  <pre><code>pnpm add @cognivo/components @cognivo/core</code></pre>

  {grouped.map(g => (
    <section id={g.id}>
      <h2>
        {g.label}
        <span class="cat-count">{g.items.length}</span>
      </h2>
      <div class="grid">
        {g.items.map(comp => (
          <a href={`/ai/${comp.tag}`} class="card">
            <span class="card-icon">◆</span>
            <div class="card-info">
              <span class="card-name">{comp.name}</span>
              <span class="card-tag">&lt;{comp.tag}&gt;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <style>
    h1 {
      font-size: 2rem; font-weight: 700; letter-spacing: -0.03em;
      margin-bottom: 8px;
    }
    .sub { font-size: 15px; color: var(--fg-2); margin-bottom: 28px; }

    h2 {
      font-size: 18px; font-weight: 600; letter-spacing: -0.01em;
      margin: 40px 0 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
      color: var(--fg);
    }
    .cat-count {
      font: 500 12px/1 var(--font-mono);
      color: var(--fg-4);
      margin-left: auto;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 10px;
    }

    .card {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color 120ms, background 120ms;
      height: 120px;
    }
    .card:hover {
      border-color: var(--accent);
      background: var(--accent-dim);
    }
    .card-icon {
      font-size: 10px;
      color: var(--accent);
      flex-shrink: 0;
      width: 16px; text-align: center;
      margin-top: 3px;
    }
    .card-info { min-width: 0; }
    .card-name {
      display: block;
      font-size: 14px; font-weight: 500; color: var(--fg);
      margin-bottom: 4px;
    }
    .card-tag {
      display: block;
      font: 12px var(--font-mono); color: var(--fg-4);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .card:hover .card-tag { color: var(--accent); }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</DocsLayout>
