    .caveats strong { color: var(--fg); }
    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
    .ref-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
    .ref-table th { text-align: left; padding: 10px 16px; font-size: 0.6875rem; font-weight: 600; color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
