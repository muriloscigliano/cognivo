    }
    h2::before { content: ''; display: inline-block; width: 3px; height: 18px; background: var(--accent); border-radius: 2px; margin-right: 10px; }
    h3 { font-size: 15px; font-weight: 600; margin: 24px 0 8px; color: var(--fg); }
    p { margin-bottom: 12px; color: var(--fg-2); line-height: 1.7; }
    .steps { padding-left: 20px; margin: 0; color: var(--fg-2); line-height: 1.7; }
