{
  "name": "@cognivo/tokens",
  "version": "0.4.0",
  "description": "3-tier design token system (Style Dictionary v4) for Cognivo — 1,800+ tokens, theme-ready.",
  "keywords": [
    "cognivo",
    "design-system",
    "ui",
    "components",
    "design-tokens",
    "style-dictionary"
  ],
  "license": "MIT",
  "author": "Cognivo",
  "type": "module",
  "main": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/murisd/cognivo.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://cognivo.dev",
  "bugs": "https://github.com/murisd/cognivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node generate-from-palette.cjs",
    "build": "node build.js && node scripts/validate-contrast.mjs",
    "build:only": "node build.js",
    "validate:contrast": "node scripts/validate-contrast.mjs",
    "prepublishOnly": "pnpm build",
    "dev": "node build.js --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "style-dictionary": "^4.0.0"
  }
}
