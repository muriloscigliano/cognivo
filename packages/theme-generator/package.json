{
  "name": "@cognivo/theme-generator",
  "version": "0.4.0",
  "description": "CLI + SDK that turns descriptions into Cognivo tier-2 token overrides.",
  "keywords": [
    "cognivo",
    "design-system",
    "ui",
    "components",
    "theming",
    "cli"
  ],
  "license": "MIT",
  "author": "Cognivo",
  "type": "module",
  "bin": {
    "cognivo-theme": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/murisd/cognivo.git",
    "directory": "packages/theme-generator"
  },
  "homepage": "https://cognivo.dev",
  "bugs": "https://github.com/murisd/cognivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/cli.js', 0o755))\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
