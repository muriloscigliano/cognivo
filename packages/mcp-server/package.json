{
  "name": "@cognivo/mcp-server",
  "version": "0.4.0",
  "description": "Model Context Protocol server — Cognivo tools for Claude / Cursor / Windsurf.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./audit": {
      "types": "./dist/server/tools/audit-page.d.ts",
      "import": "./dist/server/tools/audit-page.js"
    },
    "./validate": {
      "types": "./dist/server/tools/validate-usage.d.ts",
      "import": "./dist/server/tools/validate-usage.js"
    },
    "./catalog-types": {
      "types": "./dist/catalog/types.d.ts",
      "import": "./dist/catalog/types.js"
    },
    "./shared": {
      "types": "./dist/server/tools/_shared.d.ts",
      "import": "./dist/server/tools/_shared.js"
    },
    "./catalog.json": "./dist/catalog/catalog.json"
  },
  "bin": {
    "cognivo-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/murisd/cognivo.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://cognivo.dev",
  "bugs": "https://github.com/murisd/cognivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:catalog && tsc && pnpm copy:catalog",
    "build:catalog": "node --import tsx src/scripts/build-catalog.ts && node --import tsx src/scripts/generate-known-tags.ts",
    "copy:catalog": "node -e \"const{mkdirSync,copyFileSync}=require('node:fs');mkdirSync('dist/catalog',{recursive:true});copyFileSync('src/catalog/catalog.json','dist/catalog/catalog.json')\"",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "cognivo",
    "design-system",
    "ui",
    "components",
    "mcp",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "author": "Cognivo"
}
