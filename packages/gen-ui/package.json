{
  "name": "@cognivo/gen-ui",
  "version": "1.0.0",
  "description": "Generative UI runtime with Zod schemas — LLMs can output typed Cognivo component trees.",
  "keywords": [
    "cognivo",
    "design-system",
    "ui",
    "components",
    "generative-ui",
    "llm",
    "zod"
  ],
  "license": "MIT",
  "author": "Cognivo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/murisd/cognivo.git",
    "directory": "packages/gen-ui"
  },
  "homepage": "https://cognivo.dev",
  "bugs": "https://github.com/murisd/cognivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.1.0"
  }
}
