{
  "name": "@cognivo/ssr",
  "version": "0.4.0",
  "description": "@lit-labs/ssr integration — server-render Cognivo components with declarative shadow DOM.",
  "keywords": [
    "cognivo",
    "design-system",
    "ui",
    "components",
    "ssr",
    "lit-ssr",
    "nextjs",
    "astro"
  ],
  "license": "MIT",
  "author": "Cognivo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/murisd/cognivo.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://cognivo.dev",
  "bugs": "https://github.com/murisd/cognivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && pnpm build",
    "dev": "tsc -p tsconfig.json --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cognivo/components": "workspace:*",
    "@lit-labs/ssr": "^4.0.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
